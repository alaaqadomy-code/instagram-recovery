0:{"buildId":"YwjTlaeWYuD0ZcGVywOSe","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"mx-auto max-w-3xl px-4 py-12 sm:px-6","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","p",null,{"className":"text-sm font-bold text-[#1d4ed8]","children":[["$","$L3",null,{"href":"/","children":"الرئيسية"}]," · ",["$","$L3",null,{"href":"/articles","children":"المدونة"}]," · ","حالات الحساب"]}],["$","h1",null,{"className":"mt-3 text-3xl font-extrabold leading-[1.4] sm:text-4xl","children":"استرجاع حساب انستقرام محذوف: المهلة والخطوات"}],["$","p",null,{"className":"mt-4 text-sm text-slate-500","children":["نُشر ","2026-09-24"," · تحديث ","2026-09-27"," · ",8," دقائق"]}],null,["$","div",null,{"className":"mt-8 space-y-8","children":[["$","section","open-0",{"children":[null,[["$","p","استرجاع حساب انستقرام محذوف ممكن",{"className":"mt-3 rounded-2xl bg-blue-50 p-4 text-base leading-8 text-slate-800","children":["استرجاع حساب انستقرام محذوف ممكن غالبًا إذا كان الحذف ضمن نافذة الانتظار قبل الحذف النهائي. إنستغرام يمهل المستخدم فترة لإعادة تسجيل الدخول وإلغاء الطلب. بعد انتهاء النافذة تُحذف البيانات بشكل يصعب عكسه."]}],["$","p","كثيرون يظنون الحساب محذوفًا وهو ",{"className":"mt-3 leading-8 text-slate-700","children":["كثيرون يظنون الحساب محذوفًا وهو معطّل. افتح الرابط العام أولًا. إن ظهرت رسالة تعطيل فمسارك مراجعة لا إلغاء حذف."]}]]]}],["$","section","الحذف بالخطأ مقابل الحذف النهائي-1",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"الحذف بالخطأ مقابل الحذف النهائي"}],[["$","p","إن طلبت الحذف من الإعدادات وما ز",{"className":"mt-3 leading-8 text-slate-700","children":["إن طلبت الحذف من الإعدادات وما زلت داخل المهلة، سجّل الدخول باسم المستخدم وكلمة السر من التطبيق الرسمي. غالبًا يظهر خيار إلغاء الحذف مباشرة."]}],"$L4"]]}],"$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1