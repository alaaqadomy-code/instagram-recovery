4:["$","p","إن لم تعد كلمة السر تعمل، فالمشك",{"className":"mt-3 leading-8 text-slate-700","children":["إن لم تعد كلمة السر تعمل، فالمشكلة مركّبة: حذف مع فقدان دخول. ابدأ باستعادة وسيلة التحقق إن كانت ما زالت بحوزتك، ثم بإلغاء الحذف إن فُتح الحساب."]}]
5:["$","section","ماذا لو حذف المخترق الحساب؟-2",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو حذف المخترق الحساب؟"}],[["$","p","إن غيّر المخترق البيانات ثم حذف،",{"className":"mt-3 leading-8 text-slate-700","children":["إن غيّر المخترق البيانات ثم حذف، تعامل معها كاختراق أولًا. كل يوم تأخير يقلل أثر روابط التراجع عبر البريد. لا تنتظر انتهاء مهلة الحذف دون محاولة مسار «حسابي اختُرق»."]}],["$","p","احفظ أي إيميل من إنستغرام عن تغي",{"className":"mt-3 leading-8 text-slate-700","children":["احفظ أي إيميل من إنستغرام عن تغيير البريد أو الحذف؛ هذه الرسائل أدلة زمنية قوية."]}]]]}]
6:["$","section","بعد انتهاء مهلة الحذف-3",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"بعد انتهاء مهلة الحذف"}],[["$","p","الحذف النهائي يعني أن اليوزر قد ",{"className":"mt-3 leading-8 text-slate-700","children":["الحذف النهائي يعني أن اليوزر قد يُطلق لاحقًا لشخص آخر، والمحتوى لا يُستعاد كالأرشيف الكامل في العادة. يمكنك تنزيل بياناتك مسبقًا إن كان الحساب ما زال مفتوحًا؛ بعد الحذف النهائي قد لا تتوفر النسخة."]}],["$","p","لا تدفع لمن يعدك باسترجاع كل الم",{"className":"mt-3 leading-8 text-slate-700","children":["لا تدفع لمن يعدك باسترجاع كل المنشورات بعد الحذف النهائي. ركّز على حماية هويتك ومنع انتحال الاسم إن أُعيد تسجيله."]}]]]}]
7:["$","section","تفاصيل إضافية للحالة نفسها-4",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"تفاصيل إضافية للحالة نفسها"}],[["$","p","استرجاع حساب الانستقرام المحذوف ",{"className":"mt-3 leading-8 text-slate-700","children":["استرجاع حساب الانستقرام المحذوف ينجح داخل المهلة التي تعرضها إنستغرام بعد طلب الحذف أو بعد إلغاء التنشيط المرتبط بمسار الحذف. ميتا توضح في مركز المساعدة أن التراجع متاح لفترة محدودة قبل الحذف النهائي. بعد انتهاء المهلة لا توجد أداة خارجية تعيد المنشورات والمتابعين."]}],["$","p","دوّن تاريخ آخر دخول ناجح تعرفه و",{"className":"mt-3 leading-8 text-slate-700","children":["دوّن تاريخ آخر دخول ناجح تعرفه وتاريخ رسالة الحذف إن وُجدت. الفرق بينهما يوضح إن كنت داخل المهلة أم خارجها أوضح من تقدير بالأسابيع. احتفظ بهذه التواريخ في ملاحظة بلا أسرار."]}],["$","p","إن شاركك آخرون كلمة السر سابقاً ",{"className":"mt-3 leading-8 text-slate-700","children":["إن شاركك آخرون كلمة السر سابقاً فأخبرهم أن يتوقفوا عن محاولات الدخول أثناء الاستعادة حتى لا تُستهلك الرموز أو تُفتح مهلة انتظار. جهاز واحد يطلب الاستعادة في الجلسة الواحدة أوضح للمراجع."]}],["$","p","ضع تذكيراً في التقويم قبل يومين ",{"className":"mt-3 leading-8 text-slate-700","children":["ضع تذكيراً في التقويم قبل يومين من تقدير نهاية المهلة إن عرفتها من الرسالة. التذكير أفضل من اكتشاف الاختفاء فجأة. لا تعتمد على ذاكرة الهاتف وحدها إن كنت مسافراً."]}],["$","p","أجّل إعادة تسمية نشاطك التجاري ع",{"className":"mt-3 leading-8 text-slate-700","children":["أجّل إعادة تسمية نشاطك التجاري على اللوحات الإعلانية حتى يتضح إن كانت الاستعادة ستنجح. تغيير الهوية مرتين يربك الزبائن."]}]]]}]
8:["$","section","كيف تعرف أن المهلة ما زالت سارية؟-5",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تعرف أن المهلة ما زالت سارية؟"}],[["$","p","ابحث عن رسالة من إنستغرام أو ميت",{"className":"mt-3 leading-8 text-slate-700","children":["ابحث عن رسالة من إنستغرام أو ميتا تذكر تاريخاً أو عدّاً تنازلياً. حاول تسجيل الدخول من التطبيق الرسمي؛ أحياناً يظهر زر تأكيد التراجع مباشرة. تفاصيل المهلة والخطوات في ",["$","$L3","167-/articles/istirja-hisab-mahdhuf",{"href":"/articles/istirja-hisab-mahdhuf","className":"font-semibold text-[#1d4ed8] hover:underline","children":"استرجاع حساب محذوف"}],"."]}],["$","p","إذا فتح الرابط العام لليوزر صفحة",{"className":"mt-3 leading-8 text-slate-700","children":["إذا فتح الرابط العام لليوزر صفحة فارغة أو «غير موجود» فقد تكون المهلة انتهت أو تغيّر الاسم. صوّر النتيجة. لا تعتمد على أداة ويب تدّعي كشف حالة الحذف مقابل بريدك."]}]]]}]
9:["$","section","ماذا تفعل داخل مهلة التراجع؟-6",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تفعل داخل مهلة التراجع؟"}],[["$","p","ادخل من جهاز سبق استخدامه إن أمك",{"className":"mt-3 leading-8 text-slate-700","children":["ادخل من جهاز سبق استخدامه إن أمكن، وأكمل زر التراجع أو تسجيل الدخول كما يطلب التطبيق. إن طُلب تحقق فاستخدم البريد أو الرقم المرتبطين قبل طلب الحذف. لا تؤجل اليوم الأخير من المهلة إلى منتصف الليل بلا شبكة ثابتة."]}],["$","p","بعد عودة الحساب راجع البريد والر",{"className":"mt-3 leading-8 text-slate-700","children":["بعد عودة الحساب راجع البريد والرقم في مركز الحسابات، وغيّر كلمة السر إن كنت تشك أن شخصاً طلب الحذف دون إذنك. أغلق الجلسات الغريبة. الحذف المتعمد من مخترق يُعالج أيضاً بمسار ",["$","$L3","173-/articles/ikhtiraq-hisab-alinstagram",{"href":"/articles/ikhtiraq-hisab-alinstagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الاختراق"}]," إن تغيّرت البيانات."]}]]]}]
a:["$","section","ماذا لو انتهى الحذف النهائي؟-7",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو انتهى الحذف النهائي؟"}],[["$","p","لا وعد بإعادة المتابعين والمنشور",{"className":"mt-3 leading-8 text-slate-700","children":["لا وعد بإعادة المتابعين والمنشورات بعد الحذف النهائي. أي صفحة تطلب تحويلاً ثم «استعادة من نسخة» تختلق مساراً. أنشئ حساباً جديداً إن احتجت حضوراً جديداً، واحمِ البريد والرقم من أول يوم."]}],["$","p","إن كان الحذف نتيجة تعطيل سابق فل",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان الحذف نتيجة تعطيل سابق فلا تخلط الملفين. راجع نص آخر رسالة قبل الحذف. أحياناً الناس يسمّون التعطيل حذفاً؛ الاستئناف حينها أوضح من انتظار مهلة غير موجودة."]}]]]}]
b:["$","section","هل إلغاء التنشيط هو الحذف؟-8",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل إلغاء التنشيط هو الحذف؟"}],[["$","p","إلغاء التنشيط المؤقت يخفي الملف ",{"className":"mt-3 leading-8 text-slate-700","children":["إلغاء التنشيط المؤقت يخفي الملف ويمكن عكسه بتسجيل الدخول في حالات كثيرة. الحذف مسار أشد بمهلة ثم إزالة. اقرأ الجملة في الإعدادات قبل التأكيد. مركز مساعدة إنستغرام يفصل المسارين؛ لا تعتمد على عنوان فيديو على يوتيوب."]}],["$","p","إذا كان حسابك مгноًى عنه من جهاز",{"className":"mt-3 leading-8 text-slate-700","children":["إذا كان حسابك مгноًى عنه من جهاز قديم فافتح البريد المرتبط أولاً. بدون وسيلة تحقق قد تجد نفسك خارج المهلة وأنت ما زلت تملك اليوزر في ذاكرتك فقط."]}]]]}]
c:["$","section","كيف يساعد Unlock Accounts في حالة المحذوف؟-9",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف يساعد Unlock Accounts في حالة المحذوف؟"}],[["$","p","نقارن لقطة رسالة الحذف بلقطة محا",{"className":"mt-3 leading-8 text-slate-700","children":["نقارن لقطة رسالة الحذف بلقطة محاولة الدخول ونحدد إن كان التراجع متاحاً أم أن الملف أُغلق بتعطيل يُسمّى خطأً حذفاً. لا نستلم كلمة المرور."]}],["$","p","إن انتهت المهلة نقول ذلك بوضوح ح",{"className":"mt-3 leading-8 text-slate-700","children":["إن انتهت المهلة نقول ذلك بوضوح حتى لا تدفع لوعد مستحيل. إن بقيت المهلة نوجهك لإكمال الزر الرسمي في أسرع وقت شبكة مستقر."]}]]]}]
d:["$","section","ما أول خطوة اليوم؟-10",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما أول خطوة اليوم؟"}],[["$","p","إذا طلب النظام تحققاً فاستخدم ال",{"className":"mt-3 leading-8 text-slate-700","children":["إذا طلب النظام تحققاً فاستخدم الوسيلة المرتبطة قبل الحذف. الرمز الذي يصل الآن هو باب التراجع؛ لا ترسله لمن يعد بإكمال الحذف نيابة عنك."]}]]]}]
e:["$","section","ماذا لو حُذف الحساب دون طلبك؟-11",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو حُذف الحساب دون طلبك؟"}],[["$","p","لا تنشئ فوراً حساباً بنفس الاسم ",{"className":"mt-3 leading-8 text-slate-700","children":["لا تنشئ فوراً حساباً بنفس الاسم وتعلن الاتهام. أكمل المسار الرسمي أولاً؛ الاسم قد يُحجز أو يُعاد ضمن المهلة."]}]]]}]
f:["$","section","بعد عودة الحساب ماذا تحمي؟-12",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"بعد عودة الحساب ماذا تحمي؟"}],[["$","p","حدّث البريد والرقم، غيّر السر، أ",{"className":"mt-3 leading-8 text-slate-700","children":["حدّث البريد والرقم، غيّر السر، أغلق الجلسات، راجع التطبيقات المتصلة. احفظ رموز الاسترداد إن ظهرت في مركز الحسابات بطريقتك الآمنة خارج الدردشات."]}],["$","p","إن كان الحساب لمتجر فأعد ربط قنو",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان الحساب لمتجر فأعد ربط قنوات الدعم في البايو بعد التأكد من ثبات الاسم. لا تستورد أدوات نشر جماعية في اليوم الأول للعودة."]}]]]}]
10:["$","section","كيف تصل إلى الرابط الرسمي للحساب المحذوف؟-13",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تصل إلى الرابط الرسمي للحساب المحذوف؟"}],[["$","p","اكتب instagram.com بنفسك إن شككت",{"className":"mt-3 leading-8 text-slate-700","children":["اكتب instagram.com بنفسك إن شككت في رابط مختصر وصلك في رسالة. الصفحة التي تعرض عداد حذف مزيف ثم خانة سر تجمع بيانات. أغلقها واحفظ لقطة رسالة الحذف الحقيقية إن كانت عندك في البريد أو في لقطة قديمة."]}],["$","p","إن كنت على جهاز جديد فثبّت التطب",{"className":"mt-3 leading-8 text-slate-700","children":["إن كنت على جهاز جديد فثبّت التطبيق من المتجر أولاً وافتح البريد على الجهاز نفسه قبل طلب الرمز. الشبكة العامة في المطار تؤخر الرسائل؛ انتقل إلى شبكة ثابتة إن استطعت قبل المحاولة الوحيدة المرتبة."]}]]]}]
11:["$","section","ماذا يحسب ضمن مهلة الاستعادة؟-14",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا يحسب ضمن مهلة الاستعادة؟"}],[["$","p","المهلة تبدأ من تأكيد الحذف أو من",{"className":"mt-3 leading-8 text-slate-700","children":["المهلة تبدأ من تأكيد الحذف أو من بدء المسار حسب ما تعرضه ميتا في رسالتها، لا من يوم آخر منشور تتذكره. ابحث في البريد عن تاريخ الإشعار. لا تعتمد على منشورات المنتديات التي تثبّت رقماً واحداً لكل الحالات؛ النص الظاهر لحسابك هو المرجع."]}]]]}]
12:["$","section","ما الذي تثبته قبل الضغط على استعادة؟-15",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الذي تثبته قبل الضغط على استعادة؟"}],[["$","p","يوزر الحساب، والبريد أو الرقم ال",{"className":"mt-3 leading-8 text-slate-700","children":["يوزر الحساب، والبريد أو الرقم المرتبط سابقاً، والجهاز الذي اعتدت الدخول منه. إن طُلب رمز فاستلمه مرة واحدة على الوسيلة الظاهرة. التكرار يفتح مهلة انتظار ويختلط عليك أي رمز هو الأخير."]}],["$","p","إن طُلب منك اختيار وسيلة قديمة ل",{"className":"mt-3 leading-8 text-slate-700","children":["إن طُلب منك اختيار وسيلة قديمة لا تصل إليها فاختر صراحة أنك لا تستطيع استخدامها بدل تخمين رموز. التخمين يستهلك المحاولات ويؤخر إثبات الملكية."]}]]]}]
13:["$","section","هل رابط المحذوف يصلح للحساب المعطل؟-16",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل رابط المحذوف يصلح للحساب المعطل؟"}],[["$","p","بعض الناس يسمّون كل إغلاق حذفاً.",{"className":"mt-3 leading-8 text-slate-700","children":["بعض الناس يسمّون كل إغلاق حذفاً. افحص الكلمات على الشاشة: deactivated وdisabled وdeleted تترجم بصور مختلفة في العربية. انسخ النص الإنجليزي إن ظهر بجانب العربي ليكون التشخيص أدق."]}],["$","p","إن كان الملف تجارياً مربوطاً بصف",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان الملف تجارياً مربوطاً بصفحة فيسبوك فحاول فتح مركز الحسابات من فيسبوك على جهاز موثوق؛ أحياناً يظهر وضع الحساب أوضح من شاشة الجوال وحدها. لا تغيّر وسائل الحساب الآخر بالتخمين."]}]]]}]
14:["$","section","ماذا بعد نجاح الاستعادة من الرابط؟-17",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا بعد نجاح الاستعادة من الرابط؟"}],[["$","p","حدّث تطبيقات الطرف الثالث الشرعي",{"className":"mt-3 leading-8 text-slate-700","children":["حدّث تطبيقات الطرف الثالث الشرعية التي كانت مربوطة للنشر اليدوي بعد أن تتأكد من صلاحياتها. أزل ما لا تتعرف عليه. الظهور بعد الاستعادة بلا تنظيف جلسات يعيد الخطر."]}]]]}]
15:["$","section","متى تتوقف عن الروابط الجاهزة؟-18",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى تتوقف عن الروابط الجاهزة؟"}],[["$","p","صفحة [الخدمات](/services) عندنا ",{"className":"mt-3 leading-8 text-slate-700","children":["صفحة ",["$","$L3","5-/services",{"href":"/services","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الخدمات"}]," عندنا تبدأ من قراءة اللقطة. الأسئلة في ",["$","$L3","65-/faq",{"href":"/faq","className":"font-semibold text-[#1d4ed8] hover:underline","children":"faq"}]," تساعد بعد أن تعرف إن كانت رسالتك حذفاً أم تعطيلاً. القرار النهائي لعودة الملف يبقى عند ميتا داخل المهلة الرسمية."]}],["$","p","إذا ضغطت رابطاً مشبوهاً دون إدخا",{"className":"mt-3 leading-8 text-slate-700","children":["إذا ضغطت رابطاً مشبوهاً دون إدخال سر فاعتبر الحادثة منتهية بعد الإغلاق. إذا أدخلت سراً فغيّر كلمات سر البريد المرتبطة فوراً من مزود البريد، ثم عد لمسار إنستغرام الرسمي."]}]]]}]
16:["$","section","ماذا تقول للمتابعين أثناء المهلة؟-19",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تقول للمتابعين أثناء المهلة؟"}],[["$","p","جملة واحدة من قناة أخرى تكفي: ال",{"className":"mt-3 leading-8 text-slate-700","children":["جملة واحدة من قناة أخرى تكفي: الحساب في مسار استعادة رسمي وسأعود عند اكتماله. لا تنشر وعوداً بتاريخ ساعة ثابتة. لا تطلب من المتابعين إرسال رموز تصلهم إلى هاتفك."]}]]]}]
17:["$","section","كيف تتأكد أن الحساب محذوف لا معطّل؟-20",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تتأكد أن الحساب محذوف لا معطّل؟"}],[["$","p","اطلب من صديق موثوق أن يبحث عن ال",{"className":"mt-3 leading-8 text-slate-700","children":["اطلب من صديق موثوق أن يبحث عن اليوزر من جهازه ويرسل لك لقطة النتيجة. رؤيتك أنت قد تختلف إن بقيت جلسة كاش. قارن اللقطتين."]}]]]}]
18:["$","section","ماذا لو انتهت المهلة؟-21",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو انتهت المهلة؟"}],[["$","p","انقل أرشيفك البصري إلى تنظيم مجل",{"className":"mt-3 leading-8 text-slate-700","children":["انقل أرشيفك البصري إلى تنظيم مجلدات بأسماء الحملات قبل الإطلاق من حساب جديد. الترتيب يعوّض جزئياً فقدان الإحصاءات القديمة."]}],["$","p","أخبر الشركاء أن اليوزر الجديد مخ",{"className":"mt-3 leading-8 text-slate-700","children":["أخبر الشركاء أن اليوزر الجديد مختلف. الخطط التي تعتمد على الرابط القديم تُحدَّث يدوياً في السير والمواد المطبوعة."]}]]]}]
19:["$","section","ماذا تجهّز قبل الضغط على استعادة؟-22",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تجهّز قبل الضغط على استعادة؟"}],[["$","p","تأكد أن لوحة المفاتيح لا تدرج مس",{"className":"mt-3 leading-8 text-slate-700","children":["تأكد أن لوحة المفاتيح لا تدرج مسافة في نهاية اليوزر. المسافة الخفية تفشل المطابقة أحياناً."]}]]]}]
1a:["$","section","هل الحذف الاختياري يختلف عن اختفاء بعد اختراق؟-23",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل الحذف الاختياري يختلف عن اختفاء بعد اختراق؟"}],[["$","p","إن وجدت منشوراً باسمك بعد «الحذف",{"className":"mt-3 leading-8 text-slate-700","children":["إن وجدت منشوراً باسمك بعد «الحذف» من شخص آخر فوثّق الانتحال من حساب تملكه. المسار قد يجمع بلاغ انتحال مع استعادة إن بقيت المهلة. لا تراسل المنتحل بكلمة سرك القديمة."]}]]]}]
1b:["$","section","ماذا بعد عودة الحساب المحذوف؟-24",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا بعد عودة الحساب المحذوف؟"}],[["$","p","أعد تفعيل التنبيهات الأمنية. راج",{"className":"mt-3 leading-8 text-slate-700","children":["أعد تفعيل التنبيهات الأمنية. راجع قائمة المتابَعين الذين أُضيفوا قبيل الحذف إن كان اختراقاً؛ أزل من لا تعرفه."]}]]]}]
1c:["$","section","هل الاستعادة تعيد التمييز والتحقق؟-25",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل الاستعادة تعيد التمييز والتحقق؟"}],[["$","p","الشارات والحالات الخاصة تخضع لقو",{"className":"mt-3 leading-8 text-slate-700","children":["الشارات والحالات الخاصة تخضع لقواعد ميتا وقد تحتاج مراجعة بعد عودة الملف. لا تفترض عودة كل وسام تلقائياً. راقب الإعدادات بعد الدخول واقرأ أي إشعار جديد."]}]]]}]
1d:["$","section","ماذا عن المحتوى المحفوظ عند الآخرين؟-26",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا عن المحتوى المحفوظ عند الآخرين؟"}],[["$","p","المنشورات التي حفظها متابعون أو ",{"className":"mt-3 leading-8 text-slate-700","children":["المنشورات التي حفظها متابعون أو أعادوا مشاركتها قد تبقى آثارها خارج ملفك. الاستعادة لا تمسح نسخ الآخرين بالضرورة. ركّز على ترتيب ملفك أنت بعد العودة."]}]]]}]
