4:["$","p","سجّل تاريخ الإرسال. لا تغيّر الق",{"className":"mt-3 leading-8 text-slate-700","children":["سجّل تاريخ الإرسال. لا تغيّر القصة في طلب ثانٍ بعد يوم. إن طُلب فيديو فأجب داخل نفس المسار."]}]
5:["$","section","تفاصيل إضافية للحالة نفسها-3",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"تفاصيل إضافية للحالة نفسها"}],[["$","p","نموذج مراجعة حساب انستقرام المعط",{"className":"mt-3 leading-8 text-slate-700","children":["نموذج مراجعة حساب انستقرام المعطل هو الطلب الذي تعرضه ميتا بعد رسالة التعطيل، داخل التطبيق أو على instagram.com. ليس ملفاً واحداً يُحمَّل من مواقع الشرح. الحقول تتغير: اسم المستخدم، وبريد للتواصل، وشرح قصير، وأحياناً تحقق هوية. إذا لم يظهر النموذج فارجع إلى ",["$","$L3","258-/articles/la-yazhar-zar-istinaf",{"href":"/articles/la-yazhar-zar-istinaf","className":"font-semibold text-[#1d4ed8] hover:underline","children":"غياب زر الاستئناف"}],"."]}],["$","p","اكتب أنك المالك، ومتى لاحظت التع",{"className":"mt-3 leading-8 text-slate-700","children":["اكتب أنك المالك، ومتى لاحظت التعطيل، وما الذي تطلبه: مراجعة القرار. تجنب الشتائم والوعد بتكرار السلوك نفسه. صياغة أوضح في ",["$","$L3","122-/articles/istinaf-hisab-instagram",{"href":"/articles/istinaf-hisab-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"استئناف يُقرأ"}],". لا ترفق كلمة السر في أي خانة."]}]]]}]
6:["$","section","ما الذي يضعف النموذج؟-4",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الذي يضعف النموذج؟"}],[["$","p","إرساله عشر مرات في يوم واحد بنصو",{"className":"mt-3 leading-8 text-slate-700","children":["إرساله عشر مرات في يوم واحد بنصوص متناقضة. استخدام بريد لا تفتحه في خانة التواصل. اختيار سبب «نسيت كلمة السر» بينما الشاشة تقول إن الحساب عُطّل. أرسل نسخة واحدة بعد أن تجتمع اللقطة والإثبات."]}]]]}]
7:["$","section","ماذا ترفق مع النموذج من غير مبالغة؟-5",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا ترفق مع النموذج من غير مبالغة؟"}],[["$","p","لقطة رسالة التعطيل، واليوزر مكتو",{"className":"mt-3 leading-8 text-slate-700","children":["لقطة رسالة التعطيل، واليوزر مكتوباً كما هو، وبريداً تفتحه للرد. إذا طُلب وصف للجهاز المعتاد فاذكر نوعه: آيفون أو أندرويد، من غير رقم تسلسلي إلا إذا طلبته الخانة. صور الهوية تُرفع في الخانة الرسمية إن ظهرت، لا في دردشة قبل النموذج."]}],["$","p","أرسل ثم انتظر. إعادة الإرسال لأن",{"className":"mt-3 leading-8 text-slate-700","children":["أرسل ثم انتظر. إعادة الإرسال لأنك قلقت لا تضيف دليلاً. إذا وصل بريد يؤكد الاستلام فاحتفظ به مع اللقطة. نقارن نصك بالشاشة قبل الإرسال عندما تطلب ذلك."]}]]]}]
8:["$","section","بأي بريد تملأ خانة التواصل؟-6",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"بأي بريد تملأ خانة التواصل؟"}],[["$","p","ببريد تفتحه اليوم، لا بالبريد ال",{"className":"mt-3 leading-8 text-slate-700","children":["ببريد تفتحه اليوم، لا بالبريد الذي كان على الحساب إذا كنت فقدت صندوقه. ميتا قد ترد على خانة التواصل بينما الحساب مغلق. إذا امتلأ هذا الصندوق فضاعت النتيجة وأنت تنتظر داخل التطبيق. اكتب العنوان كاملاً وتجنب الأخطاء في حرف واحد."]}],["$","p","لا تضع بريد وسيط «يستلم عنك» إلا",{"className":"mt-3 leading-8 text-slate-700","children":["لا تضع بريد وسيط «يستلم عنك» إلا إذا كنت تقرأ ذلك الصندوق بنفسك. الرد الذي يصل إلى غيرك قد يضيع أو يُستخدم للضغط عليك. بعد الإرسال احتفظ برقم الطلب إن ظهر، مع لقطة الشاشة الأخيرة. نراجع الصياغة قبل هذه الخطوة إذا أرسلت النص بلا سر."]}]]]}]
9:["$","section","حد هذه الصفحة-7",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"حد هذه الصفحة"}],[["$","p","صياغة طلب المراجعة تُكتب هنا. تش",{"className":"mt-3 leading-8 text-slate-700","children":["صياغة طلب المراجعة تُكتب هنا. تشخيص التعطيل نفسه في ",["$","$L3","52-/articles/istirja-hisab-instagram-muattal",{"href":"/articles/istirja-hisab-instagram-muattal","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الحساب المعطل"}],"، ولا تُنسخ هذه الصفحة كدليل ثانٍ لنفس الحالة."]}]]]}]
