4:["$","p","صوّر الشاشة قبل إغلاقها. الجملة ",{"className":"mt-3 leading-8 text-slate-700","children":["صوّر الشاشة قبل إغلاقها. الجملة تحدد الخطوة: رمز تملكه، أو تأكيد أنك أنت، أو عبارة Challenge required. في Unlock Accounts نقرأ اللقطة ونسمّي إن كان المسار تحققاً أو تعطيلاً أو اختراقاً. لا نطلب كلمة المرور، ولا نضمن أن ميتا تقبل المحاولة الأولى."]}]
5:["$","section","كيف تفرّق القفل الاحترازي عن الباند والتعطيل؟-1",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تفرّق القفل الاحترازي عن الباند والتعطيل؟"}],[["$","p","القفل الاحترازي يبقي الحساب موجو",{"className":"mt-3 leading-8 text-slate-700","children":["القفل الاحترازي يبقي الحساب موجوداً ويطلب إثباتاً أن الجالس أمام الشاشة هو صاحبه. الباند يذكر حظراً أو أياماً أو منعاً لميزة، ومساره في ",["$","$L3","136-/articles/fak-band-instagram",{"href":"/articles/fak-band-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"فك باند انستقرام"}],". التعطيل يذكر معايير المجتمع أو شروط الاستخدام ويمنع الإدارة بقرار مراجعة."]}],["$","p","افتح رابط اسم المستخدم من متصفح ",{"className":"mt-3 leading-8 text-slate-700","children":["افتح رابط اسم المستخدم من متصفح وأنت خارج الدخول. بقاء الصورة والاسم مع طلب تحقق عند محاولة الدخول يرجّح القفل الاحترازي. اختفاء الصفحة، أو نص حذف، مسار آخر. إنشاء حساب جديد بالاسم نفسه لا يعيد منشورات الملف المقفل، وتفصيل الفرق في ",["$","$L3","232-/articles/mushkilat-tasjeel-dukhool",{"href":"/articles/mushkilat-tasjeel-dukhool","className":"font-semibold text-[#1d4ed8] hover:underline","children":"كيفية فتح حساب انستقرام"}],"."]}],["$","p","اكتب في سطر واحد ما تراه: رمز، س",{"className":"mt-3 leading-8 text-slate-700","children":["اكتب في سطر واحد ما تراه: رمز، سيلفي، أو جملة مخالفة. السطر يمنعك من تجربة النماذج الثلاثة في ساعة واحدة. النموذج المطابق للجملة هو الذي يُراجع."]}]]]}]
6:["$","section","ماذا تجهّز قبل أن تبدأ التحقق؟-2",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تجهّز قبل أن تبدأ التحقق؟"}],[["$","p","جهّز اسم المستخدم كما هو، بلا مس",{"className":"mt-3 leading-8 text-slate-700","children":["جهّز اسم المستخدم كما هو، بلا مسافة زائدة وبلا @. افتح البريد على الجهاز نفسه الذي ستطلب منه الرمز، حتى لا تنتقل بين هاتفين والمهلة تجري. إذا كان الرقم هو الوسيلة الوحيدة، تأكد أن الشريحة في الجهاز وأن الرسائل لا تُحجب كتطبيق إعلانات."]}],["$","p","اختر مكاناً بإضاءة ثابتة إذا احت",{"className":"mt-3 leading-8 text-slate-700","children":["اختر مكاناً بإضاءة ثابتة إذا احتملت الشاشة طلب وجه. ابدأ على شبكة واحدة وأكمل عليها. الانتقال من واي فاي عام إلى بيانات الخط في منتصف الرفع يقطع النموذج. اكتب ساعة المحاولة في الملاحظة بجانب اللقطة، حتى تعرف أي رمز هو الأخير إذا وصل أكثر من واحد."]}],["$","p","إذا كان القفل لأن تطبيق المصادقة",{"className":"mt-3 leading-8 text-slate-700","children":["إذا كان القفل لأن تطبيق المصادقة ضاع مع هاتف قديم، فمسار الرمز يختلف عن مسار السيلفي. تفاصيل تطبيق المصادقة في ",["$","$L3","111-/articles/mushkilat-al-mudaaqa-thunaiya",{"href":"/articles/mushkilat-al-mudaaqa-thunaiya","className":"font-semibold text-[#1d4ed8] hover:underline","children":"مشكلة المصادقة الثنائية"}],". جهّز أكواد الاسترداد إن حفظتها يوم التفعيل، وأدخلها في صفحة إنستغرام لا في موقع وسيط."]}]]]}]
7:["$","section","ماذا تفعل إذا وصل رمز التحقق؟-3",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تفعل إذا وصل رمز التحقق؟"}],[["$","p","أدخل الرمز في الصفحة التي طلبته،",{"className":"mt-3 leading-8 text-slate-700","children":["أدخل الرمز في الصفحة التي طلبته، داخل تطبيق إنستغرام من المتجر أو على instagram.com. شريط العنوان يبقى على نطاق تعرفه. أرسل الرمز مرة واحدة وانتظر. طلب رمز جديد كل دقيقة يفتح مهلة ويخلط عليك أي رقم هو الأخير."]}],["$","p","لا ترسل الرمز لمن عرض المساعدة ف",{"className":"mt-3 leading-8 text-slate-700","children":["لا ترسل الرمز لمن عرض المساعدة في تعليق أو في واتساب. الرمز يمنح دخولاً إلى الجلسة. بعد أن يفتح الحساب غيّر كلمة السر من الجهاز الذي اعتدت عليه، وراجع الجلسات في مركز الحسابات، وأغلق ما لا تعرفه."]}],["$","p","إذا وصل الرمز إلى رقم لم يعد في ",{"className":"mt-3 leading-8 text-slate-700","children":["إذا وصل الرمز إلى رقم لم يعد في يدك، فمسارك إثبات ملكية لا إعادة الطلب عشرات المرات. جهّز بريداً قديماً وصلتك منه إشعارات إنستغرام، وتواريخ منشورات، وجهازاً سبق الدخول منه. تفاصيل الرمز المتأخر في ",["$","$L3","197-/articles/kod-tahqeeq-la-yasil",{"href":"/articles/kod-tahqeeq-la-yasil","className":"font-semibold text-[#1d4ed8] hover:underline","children":"كود التحقق لا يصل"}],"."]}]]]}]
8:["$","section","ماذا لو طلب إنستغرام فيديو سيلفي؟-4",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو طلب إنستغرام فيديو سيلفي؟"}],[["$","p","سجّل الفيديو داخل النموذج الذي ف",{"className":"mt-3 leading-8 text-slate-700","children":["سجّل الفيديو داخل النموذج الذي فتحته ميتا: إضاءة ثابتة، وجه ظاهر، بلا فلتر، وبلا نظارة داكنة إذا طلبت التعليمات ذلك. إذا طُلبت ورقة باسم المستخدم فاكتب اليوزر بخط واضح وأمسكها بجانب الوجه. ارفع الملف من الصفحة نفسها حتى تظهر رسالة اكتمال."]}],["$","p","ارفض النصيحة التي تقول صوّر الهو",{"className":"mt-3 leading-8 text-slate-700","children":["ارفض النصيحة التي تقول صوّر الهوية وأرسلها في دردشة لمجهول. الهوية والفيديو يبقيان في مسار إنستغرام. شروط التصوير مجموعة في ",["$","$L3","124-/articles/video-selfie-instagram",{"href":"/articles/video-selfie-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"فيديو سيلفي انستقرام"}],"، وما يُقبل كدليل ملكية في ",["$","$L3","207-/articles/ithbat-alhuiya-instagram",{"href":"/articles/ithbat-alhuiya-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"إثبات الهوية"}],"."]}],["$","p","إذا رُفض الفيديو، لا تُعد الرفع ",{"className":"mt-3 leading-8 text-slate-700","children":["إذا رُفض الفيديو، لا تُعد الرفع كل ساعة بنسخة ضبابية. انتظر، ثم سجّل مرة واحدة بإضاءة أوضح وعلى الجهاز نفسه. تبديل الهاتف في منتصف الرفع يعيد الخطوات."]}]]]}]
9:["$","section","متى يكون القفل بسبب جهاز أو شبكة، ومتى يكون اختراقاً؟-5",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى يكون القفل بسبب جهاز أو شبكة، ومتى يكون اختراقاً؟"}],[["$","p","دخول من دولة جديدة، أو من VPN، أ",{"className":"mt-3 leading-8 text-slate-700","children":["دخول من دولة جديدة، أو من VPN، أو من هاتف استعدت عليه نسخة، يطلق تحققاً. أوقف VPN، أكمل الخطوة مرة واحدة على شبكة أهدأ، واتبع تفصيل السفر في ",["$","$L3","141-/articles/qufl-baad-safar",{"href":"/articles/qufl-baad-safar","className":"font-semibold text-[#1d4ed8] hover:underline","children":"قفل الحساب بعد السفر أو جهاز جديد"}],". عبارة Challenge required لها صفحة قصيرة للخطأ الإنجليزي: ",["$","$L3","262-/articles/challenge-required-instagram",{"href":"/articles/challenge-required-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"حل مشكلة Challenge required"}],"."]}],["$","p","بريد عن تغيير كلمة السر، أو عن ت",{"className":"mt-3 leading-8 text-slate-700","children":["بريد عن تغيير كلمة السر، أو عن تسجيل دخول من مدينة لم تكن فيها، ينقل الحالة إلى مسار اختراق. لا تؤكد الطلب إذا لم تصدره أنت. راجع صندوق البريد القديم قبل أي ضغطة، ثم ",["$","$L3","166-/articles/ikhtiraq-hisab-alinstagram",{"href":"/articles/ikhtiraq-hisab-alinstagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"استرجاع الحساب المخترق"}],". القفل الذي يحميك قد يكون أيضاً أثر محاولة دخول من غيرك."]}],["$","p","لا تنشئ حساباً ثانياً بالبيانات ",{"className":"mt-3 leading-8 text-slate-700","children":["لا تنشئ حساباً ثانياً بالبيانات نفسها أثناء القفل. الربط بين الملفين في اليوم نفسه يعقّد المراجعة على الملف الأصلي. إذا كان العمل يحتاج حضوراً فورياً، استخدم قناة تملكها خارج إنستغرام إلى أن ينتهي التحقق."]}]]]}]
a:["$","section","ماذا تفعل إذا رُفض التحقق أو انقطع؟-6",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تفعل إذا رُفض التحقق أو انقطع؟"}],[["$","p","اقرأ أي جملة تظهر بعد الرفض وانس",{"className":"mt-3 leading-8 text-slate-700","children":["اقرأ أي جملة تظهر بعد الرفض وانسخها بجانب اللقطة الأولى. السبب المكتوب يحدد الإعادة: إضاءة، وجه غير واضح، أو وسيلة لم تعد ملكك. سجّل محاولة واحدة لاحقة بعد تصحيح ذلك السبب. عشر لقطات في الساعة نفسها تُقرأ تكراراً لا إثباتاً أوضح."]}],["$","p","إذا لم يصل الرمز، بدّل الوسيلة م",{"className":"mt-3 leading-8 text-slate-700","children":["إذا لم يصل الرمز، بدّل الوسيلة مرة واحدة إن عرض النموذج البريد بدل الرقم، أو العكس، بشرط أن الوسيلة الثانية تصل إليك. إذا ضاع البريد والرقم معاً، فالنموذج التالي إثبات ملكية: تواريخ منشورات، جهاز معتاد، وبريد قديم. تفاصيل الأدلة في ",["$","$L3","232-/articles/ithbat-milkiya-instagram",{"href":"/articles/ithbat-milkiya-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"إثبات ملكية الحساب"}],"."]}],["$","p","احتفظ بنص واحد للواقعة: متى آخر ",{"className":"mt-3 leading-8 text-slate-700","children":["احتفظ بنص واحد للواقعة: متى آخر دخول ناجح، ومتى ظهرت شاشة القفل، وما الذي تغيّر في البريد أو الجهاز. تغيير القصة بين المحاولات يضعف الملف. من يعرض تجاوز السيلفي مقابل تحويل أو صورة الهوية يعمل خارج إنستغرام، والقرار يبقى داخل نموذج ميتا."]}]]]}]
b:["$","section","ماذا يرى المتابع وأنت عالق في التحقق؟-7",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا يرى المتابع وأنت عالق في التحقق؟"}],[["$","p","يبقى الملف ظاهراً للمتابعين في ك",{"className":"mt-3 leading-8 text-slate-700","children":["يبقى الملف ظاهراً للمتابعين في كثير من شاشات القفل الاحترازي، بينما تفشل شاشة دخولك أنت. هذه العلامة تفصل القفل عن الحذف. احتفظ بلقطة صفحة الدخول ولقطة الصفحة العامة لليوزر في ألبوم خارج التطبيق. أخبر جمهورك من قناة تملكها أنك تكمل تحققاً، من غير نشر رمز ولا صورة هوية. حساب على تلغرام يقدّم نفسه موظفاً لدى ميتا ويطلب مشاركة الشاشة يعمل خارج المنصة. المراجعة التي تقبل الوجه هي النموذج داخل إنستغرام ومركز مساعدة حسابات ميتا."]}],["$","p","إذا أدار أكثر من شخص الحساب، أوق",{"className":"mt-3 leading-8 text-slate-700","children":["إذا أدار أكثر من شخص الحساب، أوقفوا المحاولات المتوازية حتى تنتهي محاولة الجهاز المعتاد. محاولتان من شبكتين في الساعة نفسها تشبهان دخولاً غير معتاد وتجددان القفل. شخص واحد يكمل الرمز أو السيلفي، والباقون ينتظرون لقطة صفحة النجاح."]}]]]}]
c:["$","section","ماذا بعد أن يفتح الدخول؟-8",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا بعد أن يفتح الدخول؟"}],[["$","p","من مركز الحسابات غيّر كلمة السر،",{"className":"mt-3 leading-8 text-slate-700","children":["من مركز الحسابات غيّر كلمة السر، أنهِ الجلسات غير المعروفة، وفعّل وسيلة حماية يعرضها التطبيق إذا كانت متاحة لحسابك. أضف بريداً ثانياً يصل إليك، وأبقِ البريد القديم إذا ما زلت تفتحه. احفظ أكواد الاسترداد خارج الهاتف إن أصدرها مركز الحسابات."]}],["$","p","راجع التطبيقات المربوطة وأزل أدا",{"className":"mt-3 leading-8 text-slate-700","children":["راجع التطبيقات المربوطة وأزل أداة لا تستخدمها. جدولة النشر من تطبيق خارجي مع تغيّر الجهاز في اليوم نفسه يعيد التحدي. للحساب التجاري، اتفق على جهاز واحد يدخل أثناء أي سفر حتى لا تتوازى محاولتان من بلدين."]}],["$","p","إذا التبس عليك النص بين قفل وتحق",{"className":"mt-3 leading-8 text-slate-700","children":["إذا التبس عليك النص بين قفل وتحقق وبين جملة تعطيل، أرسل اللقطتين. في ",["$","$L3","69-/services",{"href":"/services","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الخدمات"}]," نسمّي المسار من الشاشة. القرار يبقى لميتا، ولا نطلب كلمة مرور إنستغرام."]}]]]}]
