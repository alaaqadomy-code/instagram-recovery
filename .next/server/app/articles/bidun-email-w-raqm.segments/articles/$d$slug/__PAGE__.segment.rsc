4:["$","section","حدود الواقعية-2",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"حدود الواقعية"}],[["$","p","الحسابات الجديدة بلا صور وجه وبل",{"className":"mt-3 leading-8 text-slate-700","children":["الحسابات الجديدة بلا صور وجه وبلا أصدقاء أصعب إثباتًا. الحسابات القديمة ذات النشاط أوضح. لا نعد بفتح كل حالة."]}],["$","p","لا ترسل جواز سفر عبر واتساب لشخص",{"className":"mt-3 leading-8 text-slate-700","children":["لا ترسل جواز سفر عبر واتساب لشخص غير موثّق. الإثبات يتم داخل مسار ميتا."]}]]]}]
5:["$","section","تفاصيل إضافية للحالة نفسها-3",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"تفاصيل إضافية للحالة نفسها"}],[["$","p","استرجاع حساب انستقرام عند فقدان ",{"className":"mt-3 leading-8 text-slate-700","children":["استرجاع حساب انستقرام عند فقدان الايميل رقم الهاتف كلمة السر حالة تجمع انقطاع الوسائل الثلاث معاً. ميتا قد تعرض أسئلة عن الحساب أو تحققاً بالفيديو داخل مركز المساعدة بعد أن تختار أنك لا تصل إلى البريد أو الرقم. لا توجد قائمة سرية خارج هذا المسار تعيد الدخول بمجرد دفع."]}],["$","p","ابدأ بورقة اكتب فيها كل بريد است",{"className":"mt-3 leading-8 text-slate-700","children":["ابدأ بورقة اكتب فيها كل بريد استخدمته منذ إنشاء الحساب حتى لو كان مهجوراً. جرّب استعادة تلك الصناديق قبل أن تعلن أن الإيميل ضاع نهائياً. نصف الحالات تُحل بإحياء بريد قديم."]}],["$","p","أبعد عنك صفحات «كشف إيميل انستقر",{"className":"mt-3 leading-8 text-slate-700","children":["أبعد عنك صفحات «كشف إيميل انستقرام» أثناء هذه الورقة. الوقت الذي تضيعه هناك يخصم من وقت إثبات الملكية الهادئ."]}],["$","p","البريد المرتبط بانستقرام لم يعد ",{"className":"mt-3 leading-8 text-slate-700","children":["البريد المرتبط بانستقرام لم يعد موجودًا حالة شائعة بعد إغلاق حساب جوجل أو مايكروسوفت أو نسيان الاستضافة. حاول أولًا استعادة صندوق البريد من مزوده؛ ذلك أسرع من أي استئناف."]}],["$","p","بدون أي أثر يصبح الإثبات شبه أعم",{"className":"mt-3 leading-8 text-slate-700","children":["بدون أي أثر يصبح الإثبات شبه أعمى. كن صريحًا مع نفسك حول ما تذكره ولو تقريبيًا: سنة الإنشاء، الاسم المعروض، المتابَعين."]}]]]}]
6:["$","section","ما الذي تجربه قبل إعلان فقدان كل الوسائل؟-4",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الذي تجربه قبل إعلان فقدان كل الوسائل؟"}],[["$","p","جرّب استعادة صندوق البريد عند مز",{"className":"mt-3 leading-8 text-slate-700","children":["جرّب استعادة صندوق البريد عند مزوّده، واستعادة الرقم عند المشغّل إن كان موقوفاً مؤقتاً. أحياناً تعود وسيلة واحدة خلال ساعات وتختصر المسار. راجع الأجهزة القديمة؛ جلسة محفوظة في متصفح قد تفتح مركز الحسابات دون السر الجديد."]}],["$","p","سلسلة مفاتيح الهاتف قد تحفظ سراً",{"className":"mt-3 leading-8 text-slate-700","children":["سلسلة مفاتيح الهاتف قد تحفظ سراً قديماً ما زال صالحاً. إن فشل مرتين توقف عن التخمين المتكرر لتجنب قفل إضافي كما في ",["$","$L3","115-/articles/hadd-muhawalat-instagram",{"href":"/articles/hadd-muhawalat-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"حد المحاولات"}],"."]}]]]}]
7:["$","section","كيف يبدو مسار عدم الوصول إلى الوسيلة؟-5",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف يبدو مسار عدم الوصول إلى الوسيلة؟"}],[["$","p","من شاشة المساعدة اختر أنك لا تست",{"className":"mt-3 leading-8 text-slate-700","children":["من شاشة المساعدة اختر أنك لا تستطيع استخدام البريد أو الرقم كما يوضح مركز مساعدة إنستغرام. أجب عن الأسئلة من ذاكرة صادقة: تاريخ تقريبي، أجهزة، أصدقاء مقربون إن طُلبوا. الاختلاق المتناقض يضعف الملف."]}],["$","p","إذا طُلب فيديو سيلفي فالتقطه داخ",{"className":"mt-3 leading-8 text-slate-700","children":["إذا طُلب فيديو سيلفي فالتقطه داخل الصفحة الرسمية. لا ترسل المقطع عبر واتساب. تفاصيل الدخول عند تعثّر الوسائل تتقارب مع ",["$","$L3","119-/articles/mushkilat-tasjeel-dukhool",{"href":"/articles/mushkilat-tasjeel-dukhool","className":"font-semibold text-[#1d4ed8] hover:underline","children":"مشكلة تسجيل الدخول"}],"."]}]]]}]
8:["$","section","ماذا تجهّز كأثر ملكية؟-6",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تجهّز كأثر ملكية؟"}],[["$","p","لقطات قديمة للمنشورات، وإيصالات ",{"className":"mt-3 leading-8 text-slate-700","children":["لقطات قديمة للمنشورات، وإيصالات إعلانات إن وُجدت، ومراسلات تظهر اليوزر، واسم قانوني يطابق وثيقة إن طُلب تحقق هوية لاحقاً. رتّب الملفات دون كلمة سر داخلها."]}],["$","p","حساب النشاط التجاري ينفعه سجل مد",{"className":"mt-3 leading-8 text-slate-700","children":["حساب النشاط التجاري ينفعه سجل مدير الأعمال إن بقي الوصول إليه من فيسبوك مرتبط. لا تنازل عن ذلك الوصول لشخص يعد بالفتح."]}]]]}]
9:["$","section","ما الذي ترفضه في هذه الحالة؟-7",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الذي ترفضه في هذه الحالة؟"}],[["$","p","من يطلب تحويلاً ثم يعد بتغيير ال",{"className":"mt-3 leading-8 text-slate-700","children":["من يطلب تحويلاً ثم يعد بتغيير البريد من لوحة موظف. من يطلب سراً للتجربة. من يرسل ملفاً لكسر الدخول. الثلاثة استغلال لليأس عند فقدان الوسائل."]}],["$","p","إنشاء عشر حسابات بديلة بالاسم نف",{"className":"mt-3 leading-8 text-slate-700","children":["إنشاء عشر حسابات بديلة بالاسم نفسه في يوم واحد لا يثبت الملكية؛ قد يُقرأ إساءة استخدام. ابقَ على مسار الملف الأصلي."]}]]]}]
a:["$","section","دور Unlock Accounts عند فقدان الوسائل-8",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"دور Unlock Accounts عند فقدان الوسائل"}],[["$","p","نرتب ما تبقى من آثار ونسمّي إن ك",{"className":"mt-3 leading-8 text-slate-700","children":["نرتب ما تبقى من آثار ونسمّي إن كانت الشاشة تعطيلاً يخفي وراءه وسائل أم دخولاً فقط. نراجع ترتيب الإجابات قبل الإرسال إن طلبت ذلك، دون دخول إلى الحساب."]}],["$","p","قبول ميتا للإثبات يبقى قرارها. إ",{"className":"mt-3 leading-8 text-slate-700","children":["قبول ميتا للإثبات يبقى قرارها. إن رُفض الطلب نقرأ صيغة الرفض ونحدد إن كانت جولة لاحقة تفيد أم أن الدليل غير كافٍ."]}]]]}]
b:["$","section","ما الذي تجربه قبل افتراض ضياع البريد؟-9",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الذي تجربه قبل افتراض ضياع البريد؟"}],[["$","p","إن ظهر في شاشة إنستغرام بريد منق",{"className":"mt-3 leading-8 text-slate-700","children":["إن ظهر في شاشة إنستغرام بريد منقوص فطابق الأحرف مع عناوينك القديمة. التفاصيل في ",["$","$L3","80-/articles/naseet-kalimat-sirr-lilinstagram",{"href":"/articles/naseet-kalimat-sirr-lilinstagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"نسيان كلمة السر"}]," إن وجدت وسيلة تصل أخيراً."]}],["$","p","راجع تطبيق الشركة إن كان البريد ",{"className":"mt-3 leading-8 text-slate-700","children":["راجع تطبيق الشركة إن كان البريد وظيفياً أُغلق بعد ترك العمل. اطلب من تقنية المعلومات إن كان الاسترداد ممكناً نظامياً. بريد العمل المستعاد يفتح مسار إنستغرام أحياناً."]}],["$","p","ابحث في الهاتف عن لقطات قديمة لش",{"className":"mt-3 leading-8 text-slate-700","children":["ابحث في الهاتف عن لقطات قديمة لشاشة الإعدادات تظهر البريد المنقوص. الحروف الظاهرة تضيق قائمة التخمين المشروع لعناوينك أنت لا لعناوين الغرباء."]}]]]}]
c:["$","section","كيف تستخدم الرقم أو الحساب المرتبط إن وُجد؟-10",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تستخدم الرقم أو الحساب المرتبط إن وُجد؟"}],[["$","p","لا تغيّر وسائل حساب آخر بالتخمين",{"className":"mt-3 leading-8 text-slate-700","children":["لا تغيّر وسائل حساب آخر بالتخمين. أدخل فقط ما تملكه. الخطأ المتكرر يفتح حد محاولات."]}],["$","p","إن كان الرقم انتقل لشخص آخر عبر ",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان الرقم انتقل لشخص آخر عبر شركة الاتصالات فلا تطارد المستأجر الجديد برسائل. استخدم الرقم كإثبات تاريخي في النموذج واذكر أنه لم يعد لك."]}],["$","p","مركز الحسابات عبر فيسبوك يعمل إن",{"className":"mt-3 leading-8 text-slate-700","children":["مركز الحسابات عبر فيسبوك يعمل إن بقيت جلسة فيسبوك لك على جهاز موثوق. لا تعِد تعيين سر فيسبوك عبر صفحة مقلَّدة وأنت تحاول إنقاذ إنستغرام؛ أمّن فيسبوك أولاً من تطبيقه الرسمي."]}]]]}]
d:["$","section","ماذا تجهّز لإثبات الملكية؟-11",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تجهّز لإثبات الملكية؟"}],[["$","p","رتّب الصور زمنياً. المراجع يفهم ",{"className":"mt-3 leading-8 text-slate-700","children":["رتّب الصور زمنياً. المراجع يفهم خطاً زمنياً أوضح من ملفات بأسماء عشوائية. احذف من المجلد ما يظهر بيانات عملاء حساسة قبل الرفع."]}],["$","p","إن طُلب فيديو فاتبع التعليمات ال",{"className":"mt-3 leading-8 text-slate-700","children":["إن طُلب فيديو فاتبع التعليمات الظاهرة حرفياً: الإضاءة، الحركة، الموضع. إعادة التصوير عشر مرات بتعليمات ناقصة تؤخر الملف."]}]]]}]
e:["$","section","كيف تفرّق هذه الحالة عن الاختراق؟-12",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تفرّق هذه الحالة عن الاختراق؟"}],[["$","p","إن تغيّر البريد حديثاً دون علمك ",{"className":"mt-3 leading-8 text-slate-700","children":["إن تغيّر البريد حديثاً دون علمك فأنت أقرب إلى ",["$","$L3","46-/articles/ikhtiraq-hisab-alinstagram",{"href":"/articles/ikhtiraq-hisab-alinstagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الحساب المخترق"}]," مع إمكانية رسالة أمان على البريد القديم. إن نسيت أنت الوسيلة دون أثر تغيير فأنت في فقدان وصول."]}],["$","p","صوّر أي إيميل أمان وصل للعنوان ا",{"className":"mt-3 leading-8 text-slate-700","children":["صوّر أي إيميل أمان وصل للعنوان القديم. افتحه من صندوقك. التفاصيل في مقالات رسالة الأمان إن طابقت."]}],["$","p","اطلب من أصدقاء موثوقين لقطة لملف",{"className":"mt-3 leading-8 text-slate-700","children":["اطلب من أصدقاء موثوقين لقطة لملفك كما يظهر لهم الآن: هل تغيّر الاسم أو البايو أو الرابط؟ التغيّر يدعم رواية الاستحواذ. الثبات مع فقدانك للوسائل يدعم رواية النسيان."]}]]]}]
