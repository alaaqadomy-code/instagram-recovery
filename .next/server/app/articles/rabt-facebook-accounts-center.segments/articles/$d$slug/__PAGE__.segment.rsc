5:["$","p","أحيانًا تبقى أصول الإعلانات ظاهر",{"className":"mt-3 leading-8 text-slate-700","children":["أحيانًا تبقى أصول الإعلانات ظاهرة في مدير الأعمال بينما الملف الشخصي معطّل. هذه حالة أعمال تحتاج أدلة فواتير مع الاستئناف. راجع دليل الحساب التجاري."]}]
6:["$","section","الربط من إنستغرام-3",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"الربط من إنستغرام"}],[["$","p","ادخل الحساب، ثم الإعدادات والنشا",{"className":"mt-3 leading-8 text-slate-700","children":["ادخل الحساب، ثم الإعدادات والنشاط، ثم مركز الحسابات. من الحسابات اختر إضافة حساب، ثم فيسبوك، وأكمل الدخول إلى فيسبوك الذي تملكه. بعد الربط راجع كلمة السر المشتركة والأجهزة من المركز نفسه."]}],["$","p","إن ظهر ثريدز ضمن الحسابات المربو",{"className":"mt-3 leading-8 text-slate-700","children":["إن ظهر ثريدز ضمن الحسابات المربوطة، خطواته في ",["$","$L3","46-/articles/rabt-threads-instagram",{"href":"/articles/rabt-threads-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"ربط ثريدز بإنستغرام"}],"."]}]]]}]
7:["$","section","الربط من فيسبوك-4",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"الربط من فيسبوك"}],[["$","p","من قائمة فيسبوك افتح الإعدادات و",{"className":"mt-3 leading-8 text-slate-700","children":["من قائمة فيسبوك افتح الإعدادات والخصوصية، ثم مركز الحسابات. أضف حساب إنستغرام وأنت داخل الحسابين. لا تفك ربطاً قائماً قبل أن تتأكد أنك تستطيع دخول إنستغرام بوسيلة ثانية."]}],["$","p","استعادة الوصول عندما يكون الربط ",{"className":"mt-3 leading-8 text-slate-700","children":["استعادة الوصول عندما يكون الربط قديماً مشروحة في ",["$","$L3","49-/articles/istirja-via-facebook",{"href":"/articles/istirja-via-facebook","className":"font-semibold text-[#1d4ed8] hover:underline","children":"استرجاع الحساب عن طريق فيسبوك"}],"."]}]]]}]
8:["$","section","فيسبوك يعمل وإنستغرام معطّل-5",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"فيسبوك يعمل وإنستغرام معطّل"}],[["$","p","افتح مركز الحسابات من فيسبوك. إن",{"className":"mt-3 leading-8 text-slate-700","children":["افتح مركز الحسابات من فيسبوك. إن ظهر اسم إنستغرام هناك، صوّره. التعطيل يبقى على إنستغرام، والمراجعة تُكمل من رسالة إنستغرام لا من إعدادات فيسبوك العامة. إن كان الربط قديماً وما زلت تدخل فيسبوك، جرّب مسار ",["$","$L3","204-/articles/istirja-via-facebook",{"href":"/articles/istirja-via-facebook","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الدخول عبر فيسبوك"}],"."]}],["$","p","إن أزال أحدهم الربط، فابحث في بر",{"className":"mt-3 leading-8 text-slate-700","children":["إن أزال أحدهم الربط، فابحث في بريد فيسبوك عن إشعار فك الارتباط. لا تنشئ ربطاً بحساب فيسبوك لا يخصك لنقل المتابعين."]}]]]}]
