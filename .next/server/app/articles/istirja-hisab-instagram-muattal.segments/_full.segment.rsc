29:["$","section","ما الأخطاء التي تضعف الملف المعطّل؟-7",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الأخطاء التي تضعف الملف المعطّل؟"}],[["$","p","مسح التطبيق قبل تصوير الرسالة يف",{"className":"mt-3 leading-8 text-slate-700","children":["مسح التطبيق قبل تصوير الرسالة يفقدك الدليل. حد المحاولات في ",["$","$L3","60-/articles/hadd-muhawalat-instagram",{"href":"/articles/hadd-muhawalat-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"حد المحاولات"}]," يطيل الانتظار إن كررت الطلب كل دقائق."]}]]]}]
2a:["$","section","هل التعطيل المؤقت يختلف عن النهائي؟-8",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل التعطيل المؤقت يختلف عن النهائي؟"}],[["$","p","بعض الرسائل تذكر مدة أو قيداً عل",{"className":"mt-3 leading-8 text-slate-700","children":["بعض الرسائل تذكر مدة أو قيداً على ميزات مع بقاء دخول جزئي. رسائل أخرى تمنع الدخول بالكامل. صوّر العدّاد إن وُجد. الاعتراض داخل المهلة أوضح من إنشاء حساب بالاسم نفسه فوراً. قارن أيضاً ",["$","$L3","183-/articles/fak-band-instagram",{"href":"/articles/fak-band-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"فك الباند"}]," إن كان النص عن حظر."]}],["$","p","لا تفترض أن انتهاء المدة يعيد كل",{"className":"mt-3 leading-8 text-slate-700","children":["لا تفترض أن انتهاء المدة يعيد كل شيء إن تكرر السلوك. أوقف الأداة أو المنشور المخالف قبل أن يعود الدخول. بعد العودة راجع الجلسات وغيّر السر إن شككت بدخول غريب سابق."]}]]]}]
2b:["$","section","متى تطلب ترتيب الملف مع Unlock Accounts؟-9",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى تطلب ترتيب الملف مع Unlock Accounts؟"}],[["$","p","استرجاع حساب الانستقرام المعطل م",{"className":"mt-3 leading-8 text-slate-700","children":["استرجاع حساب الانستقرام المعطل ملف ومراجعة، لا سباق روابط. قصة واحدة ودليل واضح يزيدان فرصة فهم المراجع لطلبك من القراءة الأولى."]}]]]}]
2c:["$","section","كيف تصل لرابط المراجعة دون لصق عشوائي؟-10",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تصل لرابط المراجعة دون لصق عشوائي؟"}],[["$","p","من شاشة التعطيل اتبع الزر الظاهر",{"className":"mt-3 leading-8 text-slate-700","children":["من شاشة التعطيل اتبع الزر الظاهر لطلب المراجعة أو المساعدة. من خارجها افتح التطبيق الرسمي أو اكتب النطاق بنفسك ثم مسارات المساعدة. روابط محفوظة من سنوات قديمة قد تنكسر؛ الزر الحالي أوضح."]}]]]}]
2d:["$","section","ماذا يفعل الرابط الصحيح بعد الفتح؟-11",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا يفعل الرابط الصحيح بعد الفتح؟"}],[["$","p","يعرض نموذجاً لشرح وضعك أو لرفع إ",{"className":"mt-3 leading-8 text-slate-700","children":["يعرض نموذجاً لشرح وضعك أو لرفع إثبات أو لطلب إعادة نظر. املأ الحقول بوقائع قصيرة. ارفع ما يُطلب داخل الصفحة. لا ترسل السر في حقل ملاحظات."]}],["$","p","بعد الإرسال صوّر التأكيد إن ظهر.",{"className":"mt-3 leading-8 text-slate-700","children":["بعد الإرسال صوّر التأكيد إن ظهر. انتظر. فتح الرابط عشر مرات لا يسرّع المراجعة وقد يُحسب تكراراً مزعجاً."]}]]]}]
2e:["$","section","لماذا لا يعمل رابط نسيان السر مع المعطل؟-12",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"لماذا لا يعمل رابط نسيان السر مع المعطل؟"}],[["$","p","نسيان السر يعيد تعيين دخولاً لحس",{"className":"mt-3 leading-8 text-slate-700","children":["نسيان السر يعيد تعيين دخولاً لحساب غير مقيد بقرار تعطيل كامل في كثير من الحالات. المعطل يحتاج مراجعة القرار. إن استخدمت الرابط الخطأ ضيّعت وقتاً وفتحت مهلاً بلا تقدم. اقرأ الجملة على الشاشة أولاً."]}]]]}]
2f:["$","section","ماذا تكتب بعد فتح رابط المعطل؟-13",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تكتب بعد فتح رابط المعطل؟"}],[["$","p","أرفق إيصالات أو لقطات فقط إن طلب",{"className":"mt-3 leading-8 text-slate-700","children":["أرفق إيصالات أو لقطات فقط إن طلبها النموذج أو كانت ضرورية لإثبات النشاط التجاري دون إغراق."]}]]]}]
30:["$","section","أخطاء تربطك بروابط وهمية-14",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"أخطاء تربطك بروابط وهمية"}],[["$","p","البحث عن «رابط سحري معطل» ثم إدخ",{"className":"mt-3 leading-8 text-slate-700","children":["البحث عن «رابط سحري معطل» ثم إدخال السر. دفع مقابل تفعيل رابط خاص. مشاركة الشاشة مع غريب أثناء ظهور رمز. كل ذلك يفاقم الخسارة."]}],["$","p","أنماط الاحتيال في [احتيال الاستر",{"className":"mt-3 leading-8 text-slate-700","children":["أنماط الاحتيال في ",["$","$L3","18-/articles/ihtial-istirja-instagram",{"href":"/articles/ihtial-istirja-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"احتيال الاسترجاع"}],". الدعم المرتب يقرأ لقطة بلا سر كما في ",["$","$L3","111-/services",{"href":"/services","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الخدمات"}],"."]}]]]}]
31:["$","section","بعد قبول المراجعة ماذا تفعل؟-15",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"بعد قبول المراجعة ماذا تفعل؟"}],[["$","p","ادخل، غيّر السر، راجع الجلسات، أ",{"className":"mt-3 leading-8 text-slate-700","children":["ادخل، غيّر السر، راجع الجلسات، أوقف السلوك الذي أدى للتعطيل إن كان من طرفك. أضف وسيلة استرداد ثانية. أسئلة في ",["$","$L3","110-/faq",{"href":"/faq","className":"font-semibold text-[#1d4ed8] hover:underline","children":"faq"}],"."]}]]]}]
32:["$","section","كم تنتظر قبل إعادة المحاولة؟-16",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كم تنتظر قبل إعادة المحاولة؟"}],[["$","p","أرسل طلباً واحداً ثم راقب البريد",{"className":"mt-3 leading-8 text-slate-700","children":["أرسل طلباً واحداً ثم راقب البريد. إعادة الإرسال اليومية لنص مطابق تُزدحم الملف دون دليل جديد. إذا جاء رفض عام فأضف إثباتاً ناقصاً في جولة لاحقة واحدة، كما في ",["$","$L3","158-/articles/rafd-istinaf-instagram",{"href":"/articles/rafd-istinaf-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"رفض الاستئناف"}],"."]}],["$","p","أثناء الانتظار لا تنشر من حساب ب",{"className":"mt-3 leading-8 text-slate-700","children":["أثناء الانتظار لا تنشر من حساب بديل المحتوى الذي تعتقد أنه سبب الإغلاق. أوقف أدوات النشر التلقائي المرتبطة باليوزر إن بقيت متصلة من جهاز قديم."]}]]]}]
33:["$","section","ما الأخطاء التي تطيل التعطيل؟-17",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما الأخطاء التي تطيل التعطيل؟"}],[["$","p","إنشاء حسابات متعددة لنفس النشاط ",{"className":"mt-3 leading-8 text-slate-700","children":["إنشاء حسابات متعددة لنفس النشاط في اليوم نفسه قد يُقرأ تحايلاً. دفع لصفحة تعد بالفك من لوحة داخلية غير موجود. تسليم الرمز لمن يقول إنه دعم إنستغرام. الثلاثة تضعف موقفك."]}]]]}]
34:["$","section","متى تراجع الحالة مع Unlock Accounts؟-18",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى تراجع الحالة مع Unlock Accounts؟"}],[["$","p","عندما يغيب زر الاستئناف، أو يتكر",{"className":"mt-3 leading-8 text-slate-700","children":["عندما يغيب زر الاستئناف، أو يتكرر الرفض بلا سبب مفهوم، أو يختلط التعطيل بتغيّر بريد يوحي باختراق. نقرأ اللقطات ونسمّي الخطوة التالية. حدود الخدمة في ",["$","$L3","149-/articles/khidma-mawthuqa",{"href":"/articles/khidma-mawthuqa","className":"font-semibold text-[#1d4ed8] hover:underline","children":"خدمة موثوقة"}],"."]}]]]}]
35:["$","section","كيف تتجنب خلط المسارات؟-19",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تتجنب خلط المسارات؟"}],[["$","p","شاشة نسيان السر لحساب سليم. شاشة",{"className":"mt-3 leading-8 text-slate-700","children":["شاشة نسيان السر لحساب سليم. شاشة التعطيل لمراجعة قرار. شاشة الاختراق لتغيّر بيانات. اختيار الخاطئ يضع ملفك في طابور غير مطابق. راجع أيضاً ",["$","$L3","138-/articles/mushkilat-tasjeel-dukhool",{"href":"/articles/mushkilat-tasjeel-dukhool","className":"font-semibold text-[#1d4ed8] hover:underline","children":"مشكلة تسجيل الدخول"}]," إن طلبت الشاشة تحققاً فقط."]}],["$","p","إن اختلط تعطيل مع تغيّر بريد فاج",{"className":"mt-3 leading-8 text-slate-700","children":["إن اختلط تعطيل مع تغيّر بريد فاجمع اللقطتين. قد تحتاج ترتيب أولوية بين الاستحواذ والاستئناف حسب ما يظهر أولاً."]}]]]}]
36:["$","section","ما وعود الفتح التي تتجاهلها؟-20",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما وعود الفتح التي تتجاهلها؟"}],[["$","p","فك خلال ساعة مقابل سر. موظف ميتا",{"className":"mt-3 leading-8 text-slate-700","children":["فك خلال ساعة مقابل سر. موظف ميتا عبر حساب شخصي. ملف يهز النظام. الثلاثة علامات احتيال حول الحساب المعطل."]}]]]}]
37:["$","section","ماذا يقدّم Unlock Accounts؟-21",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا يقدّم Unlock Accounts؟"}],[["$","p","قراءة نوع التعطيل من اللقطة، وتر",{"className":"mt-3 leading-8 text-slate-700","children":["قراءة نوع التعطيل من اللقطة، وترتيب الطلب، وصراحة حول الفرص الظاهرة من النص. لا دخول إلى حسابك، ولا وعد بنتيجة ثابتة."]}]]]}]
38:["$","section","متى يكون الاسترداد غير متاحاً؟-22",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى يكون الاسترداد غير متاحاً؟"}],[["$","p","غياب الزر مؤقتاً لا يساوي النهاي",{"className":"mt-3 leading-8 text-slate-700","children":["غياب الزر مؤقتاً لا يساوي النهاية دائماً؛ جرّب القناة الأخرى وابحث في البريد كما في ",["$","$L3","84-/articles/la-yazhar-zar-istinaf",{"href":"/articles/la-yazhar-zar-istinaf","className":"font-semibold text-[#1d4ed8] hover:underline","children":"غياب زر الاستئناف"}],"."]}]]]}]
39:["$","section","ما علاقة أسباب التعطيل بالاسترداد؟-23",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما علاقة أسباب التعطيل بالاسترداد؟"}],[["$","p","فهم السبب يقلل تكرار المخالفة بع",{"className":"mt-3 leading-8 text-slate-700","children":["فهم السبب يقلل تكرار المخالفة بعد أي عودة. إنذارات المحتوى المتراكمة تشرح كثيراً من الإغلاقات؛ راجع ",["$","$L3","100-/articles/asbab-taattil-instagram",{"href":"/articles/asbab-taattil-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"أسباب التعطيل"}],". الاسترداد دون تغيير السلوك يعيد الدائرة."]}]]]}]
3a:["$","section","دور Unlock Accounts في الاسترداد-24",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"دور Unlock Accounts في الاسترداد"}],[["$","p","نسمّي إن كان الملف قابلاً للمراج",{"className":"mt-3 leading-8 text-slate-700","children":["نسمّي إن كان الملف قابلاً للمراجعة من اللقطة، ونرتب الطلب، ونوضح الحدود. لا نضغط زراً داخل ميتا نيابة عنك، ولا نستلم كلمة المرور."]}],["$","p","بعد أي عودة نذكّر بغلق الجلسات و",{"className":"mt-3 leading-8 text-slate-700","children":["بعد أي عودة نذكّر بغلق الجلسات ومراجعة الوسائل حتى يثبت الاسترداد عملياً على جهازك."]}]]]}]
3b:["$","section","تفاصيل إضافية للحالة نفسها-25",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"تفاصيل إضافية للحالة نفسها"}],[["$","p","استعادة حساب الانستقرام المعطل ت",{"className":"mt-3 leading-8 text-slate-700","children":["استعادة حساب الانستقرام المعطل تعني أن إنستغرام أغلق دخولك بقرار مراجعة، لا أنك نسيت كلمة السر فقط. إنستغرام منصة تملكها ميتا، والقبول أو الرفض يبقى لديها. اقرأ الرسالة حرفاً بحرف، صوّرها كاملة مع شريط الحالة إن أمكن، واحفظ اسم المستخدم قبل أن تمسح التطبيق أو تجرب روابط من التعليقات تعدك بالفتح خلال ساعة."]}],["$","p","جهّز مسودة الشرح في تطبيق ملاحظا",{"className":"mt-3 leading-8 text-slate-700","children":["جهّز مسودة الشرح في تطبيق ملاحظات ثم الصقها في النموذج. الكتابة مباشرة في خانة صغيرة على الجوال تزيد الأخطاء والإرسال الناقص."]}]]]}]
3c:["$","section","ماذا تجمع قبل إرسال الطلب؟-26",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تجمع قبل إرسال الطلب؟"}],[["$","p","لقطة الرسالة كاملة، لقطة الصفحة ",{"className":"mt-3 leading-8 text-slate-700","children":["لقطة الرسالة كاملة، لقطة الصفحة العامة إن بقيت ظاهرة، بريد قديم وصلك منه إشعار ميتا، رقم سابق بصيغته الدولية، وتواريخ منشورات بارزة تتذكر تفاصيلها. هذه العناصر تدعم إثبات الملكية كما في ",["$","$L3","186-/articles/ithbat-milkiya-instagram",{"href":"/articles/ithbat-milkiya-instagram","className":"font-semibold text-[#1d4ed8] hover:underline","children":"إثبات ملكية الحساب"}],". لا تختلق تواريخ؛ المراجع يطابق ما خُزن عند المنصة."]}],["$","p","إن كان الحساب تجارياً فجهّز إيصا",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان الحساب تجارياً فجهّز إيصالات إعلانات أو فواتير مرتبطة بالاسم الظاهر. إن رُبط بفيسبوك وما زال مركز الحسابات يفتح من هناك فراجع الوسائل من الداخل قبل فتح بلاغ تعطيل بالخطأ. لا تلصق كلمة السر في أي مستند ترسله لطرف ثالث يعدك باستعادة الحساب الليلة."]}]]]}]
3d:["$","section","متى يكون التعطيل قيداً مؤقتاً لا إغلاقاً دائماً؟-27",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى يكون التعطيل قيداً مؤقتاً لا إغلاقاً دائماً؟"}],[["$","p","إن مُنعت من الدخول بلا عدّاد أيا",{"className":"mt-3 leading-8 text-slate-700","children":["إن مُنعت من الدخول بلا عدّاد أيام فأنت أقرب إلى مراجعة قرار لا إلى انتظار ساعة. لا تحذف التطبيق قبل حفظ اللقطة؛ المسح يزيل النسخة المحلية ولا يلغي قرار ميتا، وقد يفقدك الدليل الوحيد إن لم تحفظ الصورة في المعرض أو الملفات."]}]]]}]
3e:["$","section","هل الحساب التجاري المعطل يختلف؟-28",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"هل الحساب التجاري المعطل يختلف؟"}],[["$","p","الأدوات والإعلانات تضيف طبقات. ر",{"className":"mt-3 leading-8 text-slate-700","children":["الأدوات والإعلانات تضيف طبقات. راجع ",["$","$L3","36-/articles/hisab-tijari-muattal",{"href":"/articles/hisab-tijari-muattal","className":"font-semibold text-[#1d4ed8] hover:underline","children":"حساب تجاري معطل"}]," و",["$","$L3","87-/articles/hisab-tijari-muattal",{"href":"/articles/hisab-tijari-muattal","className":"font-semibold text-[#1d4ed8] hover:underline","children":"حساب احترافي معطل"}],". أوقف الحملات إن أمكن من مدير الإعلانات حتى لا يُصرف بلا عائد."]}],["$","p","اذكر في الطلب أن الحساب واجهة نش",{"className":"mt-3 leading-8 text-slate-700","children":["اذكر في الطلب أن الحساب واجهة نشاط بروابط ثابتة إن صدق ذلك. ليس ضماناً للفتح؛ هو سياق للمراجع. لا تخلط ملف الشخصية مع صفحة النشاط في نفس الطلب بلا توضيح."]}]]]}]
3f:["$","section","كيف تصل إلى مركز المساعدة من شاشة التعطيل؟-29",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تصل إلى مركز المساعدة من شاشة التعطيل؟"}],[["$","p","إن فتح الرابط متصفحاً مدمجاً داخ",{"className":"mt-3 leading-8 text-slate-700","children":["إن فتح الرابط متصفحاً مدمجاً داخل التطبيق فأكمل هناك إن بقي النطاق رسمياً. نسخ الرابط إلى متصفح خارجي مقبول إن راقبت العنوان. لا تلصقه في محادثة لتختصره لاحقاً من شخص آخر."]}],["$","p","حدّث التطبيق إن كان الزر لا يستج",{"className":"mt-3 leading-8 text-slate-700","children":["حدّث التطبيق إن كان الزر لا يستجيب؛ نسخة قديمة قد تكسر مسار المساعدة. التحديث من المتجر فقط."]}]]]}]
40:["$","section","ماذا تكتب في طلب مركز المساعدة؟-30",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا تكتب في طلب مركز المساعدة؟"}],[["$","p","إن كان التعطيل بعد بلاغ محتوى فا",{"className":"mt-3 leading-8 text-slate-700","children":["إن كان التعطيل بعد بلاغ محتوى فاذكر إن كنت تملك إذناً أو إن حذفت المادة، بلا مبالغة. إن كنت ترى البلاغ خطأ فاشرح أين يظهر الإذن بدليل يمكن رفعه إن طُلب."]}],["$","p","اذكر اللغة التي تفضّل الرد بها إ",{"className":"mt-3 leading-8 text-slate-700","children":["اذكر اللغة التي تفضّل الرد بها إن وُجد حقل. لا تملأ الحقل بروابط خارجية طويلة لا تخص الواقعة."]}]]]}]
41:["$","section","كيف تميّز مركز المساعدة الرسمي عن الصفحات المقلَّدة؟-31",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تميّز مركز المساعدة الرسمي عن الصفحات المقلَّدة؟"}],[["$","p","رسالتنا على الموقع لا تنتحل شعار",{"className":"mt-3 leading-8 text-slate-700","children":["رسالتنا على الموقع لا تنتحل شعار ميتا كدعم رسمي. إن وصلتك رسالة باسم مزدوج فاطلب اللقطة وقارن الرقم في ",["$","$L3","103-/contact",{"href":"/contact","className":"font-semibold text-[#1d4ed8] hover:underline","children":"التواصل"}],"."]}],["$","p","الصفحة الرسمية لا تعرض دردشة منب",{"className":"mt-3 leading-8 text-slate-700","children":["الصفحة الرسمية لا تعرض دردشة منبثة مع موظف يطالب ببعدسة كاميرا خارج النموذج. تحقق الهوية إن طُلب يكون داخل إطار ميتا الموثق في التعليمات الظاهرة."]}]]]}]
42:["$","section","ماذا لو رفض مركز المساعدة الطلب؟-32",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا لو رفض مركز المساعدة الطلب؟"}],[["$","p","صنّف الرفض: عام، أو يذكر سببًا م",{"className":"mt-3 leading-8 text-slate-700","children":["صنّف الرفض: عام، أو يذكر سببًا محدداً، أو يقول نهائياً. كل صنف يقرر إن كانت إعادة المحاولة مجدية. لا تعامل كل رفض كأنه باب مفتوح للأبد."]}]]]}]
43:["$","section","ما علاقة مركز المساعدة بنسيان كلمة السر؟-33",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما علاقة مركز المساعدة بنسيان كلمة السر؟"}],[["$","p","إن اختلطت الشاشات بمرور الوقت فا",{"className":"mt-3 leading-8 text-slate-700","children":["إن اختلطت الشاشات بمرور الوقت فاحفظ الاثنتين وأرسلهما للقراءة حتى يُسمّى المسار الحاكم الآن."]}],["$","p","إن وجدت في المساعدة مقالاً عن نس",{"className":"mt-3 leading-8 text-slate-700","children":["إن وجدت في المساعدة مقالاً عن نسيان السر بينما رسالتك تعطيل فلا تتبع مقال السر كمخرج. المقالات العامة لا تلغي نص قرار حسابك."]}],["$","p","استخدم مقالات المساعدة للفهم، وا",{"className":"mt-3 leading-8 text-slate-700","children":["استخدم مقالات المساعدة للفهم، والنموذج المرتبط برسالتك للتنفيذ. الفصل بينهما يوفر محاولات."]}]]]}]
44:["$","section","ماذا بعد قبول المراجعة؟-34",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا بعد قبول المراجعة؟"}],[["$","p","اقرأ أي شروط أو تنبيهات تظهر بعد",{"className":"mt-3 leading-8 text-slate-700","children":["اقرأ أي شروط أو تنبيهات تظهر بعد العودة. تجاهلها يعيد التصعيد. وثّق داخلياً أن الحساب عاد وتاريخ العودة."]}]]]}]
