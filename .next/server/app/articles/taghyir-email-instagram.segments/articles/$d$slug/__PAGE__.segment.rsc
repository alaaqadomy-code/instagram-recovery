0:{"buildId":"YwjTlaeWYuD0ZcGVywOSe","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"mx-auto max-w-3xl px-4 py-12 sm:px-6","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","p",null,{"className":"text-sm font-bold text-[#1d4ed8]","children":[["$","$L3",null,{"href":"/","children":"الرئيسية"}]," · ",["$","$L3",null,{"href":"/articles","children":"المدونة"}]," · ","الاختراق والأمان"]}],["$","h1",null,{"className":"mt-3 text-3xl font-extrabold leading-[1.4] sm:text-4xl","children":"استرجاع حساب انستقرام بعد تغيير الإيميل"}],["$","p",null,{"className":"mt-4 text-sm text-slate-500","children":["نُشر ","2026-09-24"," · تحديث ","2026-09-27"," · ",2," دقائق"]}],null,["$","div",null,{"className":"mt-8 space-y-8","children":[["$","section","open-0",{"children":[null,[["$","p","استرجاع حساب انستقرام بعد تغيير ",{"className":"mt-3 rounded-2xl bg-blue-50 p-4 text-base leading-8 text-slate-800","children":["استرجاع حساب انستقرام بعد تغيير الإيميل يعتمد على وصولك إلى البريد القديم خلال نافذة التراجع. إنستغرام يرسل عادة إشعارًا إلى العنوان السابق. ذلك الإشعار أهم من أي «أداة استرجاع» مدفوعة."]}],["$","p","إن لم يعد البريد القديم يعمل، ان",{"className":"mt-3 leading-8 text-slate-700","children":["إن لم يعد البريد القديم يعمل، انتقل مباشرة لإثبات الهوية ولا تضيع أيامًا في إعادة طلب الرمز على عنوان محذوف."]}]]]}],["$","section","التراجع الفوري من البريد-1",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"التراجع الفوري من البريد"}],[["$","p","ابحث في الوارد والspam عن رسائل ",{"className":"mt-3 leading-8 text-slate-700","children":["ابحث في الوارد والspam عن رسائل Instagram أو Meta بخصوص email. اضغط رابط التراجع من هاتفك لا من أجهزة عامة. بعد التراجع غيّر كلمة السر فورًا."]}],"$L4"]]}],"$L5","$L6","$L7","$L8","$L9"]}],"$La","$Lb","$Lc"]}],null,"$Ld"]}],"isPartial":"$@e","staleTime":"$f","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$f","varyParams":null},