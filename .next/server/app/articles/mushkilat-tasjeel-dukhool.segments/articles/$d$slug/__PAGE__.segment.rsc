e:["$","section","كيف تفتح حساباً قائماً أُغلق عليك؟-11",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تفتح حساباً قائماً أُغلق عليك؟"}],[["$","p","استخدم جهازاً سبق الدخول منه إن ",{"className":"mt-3 leading-8 text-slate-700","children":["استخدم جهازاً سبق الدخول منه إن أمكن. اطلب رمزاً واحداً وانتظر. راجع ",["$","$L3","69-/articles/istirja-hisab-mughlaq",{"href":"/articles/istirja-hisab-mughlaq","className":"font-semibold text-[#1d4ed8] hover:underline","children":"فتح حسابي انستقرام"}]," لنفس القصد بصياغة أخرى."]}],["$","p","رتّب المحاولات: سر، ثم وسيلة بدي",{"className":"mt-3 leading-8 text-slate-700","children":["رتّب المحاولات: سر، ثم وسيلة بديلة، ثم مساعدة، ثم إثبات ملكية. القفز مباشرة إلى حساب جديد يقطع ترتيباً كان قد ينجح خلال أيام."]}]]]}]
f:["$","section","متى يكون إنشاء حساب جديد مناسباً؟-12",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى يكون إنشاء حساب جديد مناسباً؟"}],[["$","p","عندما تريد حضوراً جديداً بعد انت",{"className":"mt-3 leading-8 text-slate-700","children":["عندما تريد حضوراً جديداً بعد انتهاء مهلة حذف، أو بعد قرار نهائي بترك اليوزر القديم، أو لبدء نشاط باسم مختلف. سجّل من التطبيق الرسمي أو instagram.com، وأكمل التحقق ببريد أو رقم يصلان إليك."]}],["$","p","لا تنشئ الحساب الجديد في ساعة قف",{"className":"mt-3 leading-8 text-slate-700","children":["لا تنشئ الحساب الجديد في ساعة قفل القديم من نفس الجهاز لتكرار محتوى مخالف. ذلك قد يُربط بالمراجعة ويُعقّد الملف الأصلي إن كان ما زال قيد الاستئناف."]}]]]}]
10:["$","section","ما خطوات التسجيل الجديد باختصار؟-13",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ما خطوات التسجيل الجديد باختصار؟"}],[["$","p","حمّل إنستغرام من المتجر، اختر إن",{"className":"mt-3 leading-8 text-slate-700","children":["حمّل إنستغرام من المتجر، اختر إنشاء حساب، أدخل وسيلة تحقق تملكها، عيّن كلمة سر قوية، اختر اسماً متاحاً. لا تشتري يوزراً من صفحات وسيطة. لا تقبل ملف تعريف خارج المتجر على آيفون لإتمام التسجيل."]}],["$","p","بعد الإنشاء أضف بريداً ثانياً إن",{"className":"mt-3 leading-8 text-slate-700","children":["بعد الإنشاء أضف بريداً ثانياً إن أمكن وفعّل الحماية المتاحة. الحساب الجديد يبدأ من صفر متابعين؛ لا تخلطه بوعد «نقل متابعين» مقابل سر."]}],["$","p","اختر اسم عرض واضحاً منذ اليوم ال",{"className":"mt-3 leading-8 text-slate-700","children":["اختر اسم عرض واضحاً منذ اليوم الأول. تغييرات الاسم المتكررة في أسبوع الإطلاق تُربك البحث عنك. جهّز صورة ملف تملك حقوقها."]}],["$","p","ارفض التطبيقات التي تعد بنقل متا",{"className":"mt-3 leading-8 text-slate-700","children":["ارفض التطبيقات التي تعد بنقل متابعين إلى الحساب الجديد مقابل سر. النقل بهذا الشكل غير مشروع في وعده ويعرّض الجلسة."]}]]]}]
11:["$","section","كيف تتجنب خلط الفتح بالاسترجاع؟-14",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"كيف تتجنب خلط الفتح بالاسترجاع؟"}],[["$","p","اكتب في مذكرتك أي المسارين بدأت ",{"className":"mt-3 leading-8 text-slate-700","children":["اكتب في مذكرتك أي المسارين بدأت اليوم. الخلط بينهما يجعلك تهمل رداً من ميتا على الملف القديم بينما تنشغل بتزيين الملف الجديد."]}],["$","p","ضع مجلدين منفصلين على سطح المكتب",{"className":"mt-3 leading-8 text-slate-700","children":["ضع مجلدين منفصلين على سطح المكتب: قديم وجديد. كل لقطة تذهب لموضعها. الخلط في الملفات يساوي الخلط في القرارات."]}],["$","p","إن وصل رد ميتا على القديم فافتحه",{"className":"mt-3 leading-8 text-slate-700","children":["إن وصل رد ميتا على القديم فافتحه فوراً حتى لو كنت منشغلاً بتزيين الجديد. الرد قد يكون فرصة زمنية محدودة."]}]]]}]
12:["$","section","ماذا بعد نجاح فتح الدخول القديم؟-15",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"ماذا بعد نجاح فتح الدخول القديم؟"}],[["$","p","قرر مصير الحساب الجديد إن كنت أن",{"className":"mt-3 leading-8 text-slate-700","children":["قرر مصير الحساب الجديد إن كنت أنشأت واحداً للانتظار: إيقاف، حذف داخل مهلة، أو تحويله لنشاط مختلف بوضوح. ترك حسابين متطابقين يربك الزبائن ويفتح باب انتحال."]}]]]}]
13:["$","section","متى تطلب قراءة من Unlock Accounts؟-16",{"children":[["$","h2",null,{"className":"text-2xl font-bold","children":"متى تطلب قراءة من Unlock Accounts؟"}],[["$","p","عندما تريد معرفة إن كانت الشاشة ",{"className":"mt-3 leading-8 text-slate-700","children":["عندما تريد معرفة إن كانت الشاشة تستدعي استرجاعاً أم أن التسجيل الجديد هو الخيار الوحيد المتبقي. نقرأ اللقطة ونقول ذلك بوضوح. صفحة ",["$","$L3","130-/services",{"href":"/services","className":"font-semibold text-[#1d4ed8] hover:underline","children":"الخدمات"}]," و",["$","$L3","152-/faq",{"href":"/faq","className":"font-semibold text-[#1d4ed8] hover:underline","children":"faq"}]," توضحان الحدود."]}],["$","p","كيفية فتح حساب انستقرام في سياق ",{"className":"mt-3 leading-8 text-slate-700","children":["كيفية فتح حساب انستقرام في سياق الاسترجاع مشروع عودة للملف أولاً، وتسجيل جديد فقط حين يكون ذلك هدفك الصريح لا اختصاراً لوعد كاذب."]}]]]}]
