تواصل بالعربية الواضحة وبتوقيتك، ونكتب كل شيء كتابةً حتى تعود إليه لاحقاً. لا مكالمات إلزامية، لا ضغط للدفع، ولا وعود. فقط ملف مرتب يصل إلى من يستطيع إعادة حسابك فعلاً."}]],["$","a",null,{"href":"https://wa.me/962795827790?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%0A%D8%A3%D8%AA%D9%88%D8%A7%D8%B5%D9%84%20%D9%85%D8%B9%D9%83%D9%85%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20Unlock%20Accounts%20%D8%A8%D8%AE%D8%B5%D9%88%D8%B5%20%D8%A7%D8%B3%D8%AA%D8%B1%D8%AC%D8%A7%D8%B9%20%D8%AD%D8%B3%D8%A7%D8%A8%20%D8%A5%D9%86%D8%B3%D8%AA%D8%BA%D8%B1%D8%A7%D9%85.%0A%D9%86%D9%88%D8%B9%20%D8%A7%D9%84%D8%AD%D8%A7%D9%84%D8%A9%3A%20%D9%85%D8%B9%D8%B7%D9%91%D9%84%20%D8%A3%D9%88%20%D9%85%D8%AE%D8%AA%D8%B1%D9%82%20%D8%A3%D9%88%20%D9%85%D8%AD%D8%B0%D9%88%D9%81.%0A%D8%A7%D8%B3%D9%85%20%D8%A7%D9%84%D9%85%D8%B3%D8%AA%D8%AE%D8%AF%D9%85%3A%0A%D8%B9%D8%AF%D8%AF%20%D8%A7%D9%84%D9%85%D8%AA%D8%A7%D8%A8%D8%B9%D9%8A%D9%86%3A%0A%D9%85%D8%AA%D9%89%20%D8%A8%D8%AF%D8%A3%D8%AA%20%D8%A7%D9%84%D9%85%D8%B4%D9%83%D9%84%D8%A9%3A%0A%D8%B3%D8%A3%D8%B1%D8%B3%D9%84%20%D9%84%D9%82%D8%B7%D8%A9%20%D8%B4%D8%A7%D8%B4%D8%A9%20%D8%B9%D9%86%20%D8%A7%D9%84%D8%AA%D8%B9%D8%B7%D9%8A%D9%84.","target":"_blank","rel":"noopener noreferrer","className":"inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-[#075E54] px-6 text-sm font-bold text-white shadow-[0_8px_20px_rgba(7,94,84,0.3)] transition hover:bg-[#054c44] mt-8","children":[["$","svg",null,{"className":"h-5 w-5","viewBox":"0 0 24 24","fill":"currentColor","aria-hidden":"true","children":["$","path",null,{"d":"$44"}]}],"أرسل لقطة الشاشة الآن"]}]]}]
