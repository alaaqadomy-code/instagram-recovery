2d:["$","div",null,{"className":"mt-6 space-y-4","children":[["$","details","هل Unlock Accounts تابع لشركة ميتا أو انستقرام؟",{"className":"group rounded-sm border border-[#e6dcc8] bg-[#fbf7f0] p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-extrabold leading-7","children":"هل Unlock Accounts تابع لشركة ميتا أو انستقرام؟"}],["$","p",null,{"className":"mt-3 leading-8 text-[#44403c]","children":"لا. نحن مكتب عربي مستقل تماماً، لا تربطنا أي علاقة رسمية بميتا أو انستقرام، ولا نملك صلاحيات داخل المنصة. ما نقدمه هو خبرة في قراءة الحالة واختيار النموذج الرسمي الصحيح وصياغة الطلب ومتابعته."}]]}],["$","details","لماذا لا تضمنون استرجاع الحساب؟",{"className":"group rounded-sm border border-[#e6dcc8] bg-[#fbf7f0] p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-extrabold leading-7","children":"لماذا لا تضمنون استرجاع الحساب؟"}],["$","p",null,{"className":"mt-3 leading-8 text-[#44403c]","children":"لأن القرار النهائي بيد فرق المراجعة في ميتا، ولا يملك أي طرف خارجي التحكم فيه. من يعدك بضمان إما يجهل كيف تعمل المنصة أو يريد المبلغ فقط. نحن نضمن جودة العمل والمتابعة والصدق في تقدير الفرص."}]]}],["$","details","كيف تعملون دون كلمة المرور؟",{"className":"group rounded-sm border border-[#e6dcc8] bg-[#fbf7f0] p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-extrabold leading-7","children":"كيف تعملون دون كلمة المرور؟"}],["$","p",null,{"className":"mt-3 leading-8 text-[#44403c]","children":"نماذج الاستئناف وإثبات الملكية لدى ميتا لا تحتاج كلمة المرور أصلاً، بل تعتمد على بيانات يملكها صاحب الحساب فقط: البريد أو الرقم المرتبط، صور إثبات الهوية عند طلبها، وتاريخ الحساب. ولهذا من يطلب كلمة المرور لا يستخدم المسار الرسمي."}]]}],["$","details","كم يكلف استرجاع الحساب؟",{"className":"group rounded-sm border border-[#e6dcc8] bg-[#fbf7f0] p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-extrabold leading-7","children":"كم يكلف استرجاع الحساب؟"}],["$","p",null,{"className":"mt-3 leading-8 text-[#44403c]","children":"لا سعر موحداً لأن الحالات تختلف جذرياً في الجهد والمدة. بعد الفحص المجاني نرسل لك السعر والمدة المتوقعة مكتوبين، وتقرر أنت. وإن كان الحل بسيطاً وداخل التطبيق نشرحه لك مجاناً دون خدمة."}]]}],["$","details","من أين تعملون ومن تخدمون؟",{"className":"group rounded-sm border border-[#e6dcc8] bg-[#fbf7f0] p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-extrabold leading-7","children":"من أين تعملون ومن تخدمون؟"}],["$","p",null,{"className":"mt-3 leading-8 text-[#44403c]","children":"نعمل عن بُعد بالعربية، ونخدم بشكل أساسي عملاء السعودية ودول الخليج، إلى جانب باقي الدول العربية. كل التواصل عبر واتساب، ولا يلزم حضور أو اتصال هاتفي."}]]}]]}]
