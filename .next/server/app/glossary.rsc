17:T1429,{"@context":"https://schema.org","@type":"DefinedTermSet","name":"مصطلحات استرجاع حساب إنستغرام","url":"https://instagram-recover.com/glossary","inLanguage":"ar","hasDefinedTerm":[{"@type":"DefinedTerm","name":"تعطيل","description":"قرار من إنستغرام يمنع الدخول لأن الحساب خالف المعايير أو وصل بلاغ. الاسترجاع يتم بطلب مراجعة، لا بإعادة تعيين كلمة السر."},{"@type":"DefinedTerm","name":"باند","description":"حظر أوسع قد يكون مؤقتًا أو نهائيًا. الباند النهائي يغلق الحساب، والمؤقت يزول بعد مدة أو بعد قبول الاعتراض."},{"@type":"DefinedTerm","name":"تعليق","description":"إيقاف مؤقت يظهر برسالة أن الحساب معلّق لحين المراجعة. غالبًا يحتاج اعتراضًا واحدًا واضحًا لا محاولات يومية متكررة."},{"@type":"DefinedTerm","name":"حذف","description":"إزالة الحساب. إن كان الحذف بيدك وما زالت المهلة مفتوحة قد يكفي تسجيل الدخول. بعد الحذف النهائي تصعب الاستعادة."},{"@type":"DefinedTerm","name":"اختراق","description":"وصول شخص آخر غيّر البريد أو الرقم أو كلمة السر. المسار إثبات ملكية، لا شراء «كود فك»."},{"@type":"DefinedTerm","name":"شادوبان","description":"انخفاض ظهور المنشورات دون إغلاق الحساب. الحساب يعمل، لكن الوصول والتفاعل ينقصان."},{"@type":"DefinedTerm","name":"حساب مقيّد","description":"قيود على النشر أو التعليق أو الرسائل مع بقاء الدخول ممكنًا. يختلف عن التعطيل الكامل."},{"@type":"DefinedTerm","name":"تعطيل مؤقت","description":"إيقاف تختاره أنت من الإعدادات. يُلغى بتسجيل الدخول خلال المهلة التي تعرضها المنصة."},{"@type":"DefinedTerm","name":"استئناف","description":"طلب مراجعة القرار عبر نموذج إنستغرام أو مركز حسابات ميتا، يشرح ملكيتك وما حدث."},{"@type":"DefinedTerm","name":"إثبات الملكية","description":"ما يربطك بالحساب: بريد قديم، رقم سابق، إيصالات إعلانات، أو تواريخ منشورات. كلمة السر وحدها ليست إثباتًا كافيًا."},{"@type":"DefinedTerm","name":"فيديو سيلفي","description":"طلب تصوير وجهك للتحقق من الهوية داخل التطبيق. يُرفض غالبًا إن كانت الصورة غير واضحة أو لا تطابق الحساب."},{"@type":"DefinedTerm","name":"تحدي تسجيل الدخول","description":"شاشة إضافية تطلب رمزًا أو تأكيدًا لأن الدخول بدا غير معتاد. ليست دائمًا علامة تعطيل."},{"@type":"DefinedTerm","name":"رمز التحقق","description":"رقم يصل إلى الجوال أو البريد لإثبات أنك صاحب الوسيلة. لا يُرسل إلى أي موقع خارج إنستغرام."},{"@type":"DefinedTerm","name":"مركز الحسابات","description":"لوحة ميتا التي تربط إنستغرام وفيسبوك. منها تُدار بعض طلبات الاسترداد والوسائل المرتبطة."},{"@type":"DefinedTerm","name":"حساب تجاري","description":"حساب مرتبط بصفحة أو إعلانات أو متجر. ملف الاستئناف يحتاج إثبات النشاط التجاري إلى جانب ملكية الحساب."},{"@type":"DefinedTerm","name":"حساب موثّق","description":"حساب عليه شارة التحقق أو اشتراك Meta Verified. التوثيق لا يمنع التعطيل ولا يضمن القبول."},{"@type":"DefinedTerm","name":"معايير المجتمع","description":"قواعد إنستغرام للمحتوى والسلوك. كثير من رسائل التعطيل تشير إليها صراحة."},{"@type":"DefinedTerm","name":"حقوق النشر","description":"بلاغ أن المحتوى منسوخ. مساره مختلف عن تعطيل معايير المجتمع ويحتاج الرد على البلاغ نفسه."},{"@type":"DefinedTerm","name":"انتحال","description":"حساب يقلّد اسمك أو صورتك. يُبلَّغ كحساب منتحل، وهذا غير استرجاع حسابك الأصلي إن سُرق."},{"@type":"DefinedTerm","name":"نموذج المراجعة","description":"النموذج الرسمي داخل المساعدة أو مركز الحسابات. الروابط المتداولة خارج التطبيق غالبًا قديمة أو تصيّد."},{"@type":"DefinedTerm","name":"كلمة السر","description":"سر الدخول. خدمة الاسترجاع الصادقة لا تطلبها ولا تطلب رمز التحقق الذي يصلك."}]}e:["$","$1","c",{"children":[["$","article",null,{"className":"mx-auto max-w-3xl px-4 py-12 sm:px-6","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18","$L19","$L1a","$L1b","$L1c"]}],null,"$L1d"]}]
