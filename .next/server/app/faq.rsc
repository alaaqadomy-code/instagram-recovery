8%B1%D8%B3%D9%84%20%D9%84%D9%82%D8%B7%D8%A9%20%D8%B4%D8%A7%D8%B4%D8%A9%20%D8%B9%D9%86%20%D8%A7%D9%84%D8%AA%D8%B9%D8%B7%D9%8A%D9%84.","target":"_blank","rel":"noopener noreferrer","aria-label":"تواصل معنا عبر واتساب","className":"fixed bottom-5 left-5 z-[70] inline-flex items-center gap-2.5 rounded-full bg-[#075E54] p-3.5 text-[15px] font-bold text-white shadow-[0_8px_24px_rgba(7,94,84,0.4)] transition hover:-translate-y-0.5 hover:bg-[#054c44] sm:px-[18px] sm:py-3","children":[["$","svg",null,{"className":"h-[30px] w-[30px] shrink-0","viewBox":"0 0 24 24","fill":"currentColor","aria-hidden":"true","children":["$","path",null,{"d":"$1d"}]}],["$","span",null,{"className":"hidden sm:inline","children":"تواصل معنا"}]]}]
