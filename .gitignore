# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# incoming recovery requests and first-party analytics
/data/requests.json
/data/*.sqlite
/data/*.sqlite-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify local cost and AST cache; the graph itself can be committed
graphify-out/cost.json
graphify-out/cache/

# local python caches
__pycache__/
*.py[cod]

# one-shot deploy archives (never commit)
next-deploy.tgz
*.deploy.tgz

# site-deploy artifacts (keep .claude/site.json tracked)
.claude/deploy/
.claude/last-deploy.json
